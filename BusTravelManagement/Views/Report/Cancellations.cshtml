@model BusTravelManagement.Models.ViewModels.CancellationReportViewModel
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Cancellation Report - BusTravel Management";
}

@section Styles {
    <style>
        .report-section { padding: 2rem 0; background: #f8f9fa; min-height: calc(100vh - 76px - 250px); }
        .stat-card { border: none; border-radius: 12px; box-shadow: 0 2px 12px rgba(0,0,0,0.06); padding: 1.25rem; height: 100%; }
        .stat-number { font-size: 1.75rem; font-weight: 800; color: #1a1a2e; }
        .stat-label { color: #6c757d; font-size: 0.85rem; }
    </style>
}

<div class="report-section">
    <div class="container-fluid px-4">
        <h4 class="fw-bold mb-4"><i class="fas fa-times-circle me-2"></i>Cancellation Report</h4>
        <p class="text-muted">Track and analyze booking cancellations and refunds.</p>
    </div>
</div>
