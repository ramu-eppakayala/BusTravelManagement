@model BusTravelManagement.Models.ViewModels.UserProfileViewModel

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "My Profile - BusTravel Management";
}

@section Styles {
    <style>
        .profile-page {
            min-height: calc(100vh - 76px - 250px);
            background: #f8f9fa;
        }
        .profile-card {
            border: none;
            border-radius: 16px;
            box-shadow: 0 2px 20px rgba(0, 0, 0, 0.06);
        }
        .profile-card .card-header {
            background: #fff;
            border-bottom: 1px solid #e9ecef;
            padding: 1.25rem 1.5rem;
            border-radius: 16px 16px 0 0 !important;
        }
        .profile-card .card-body {
            padding: 1.5rem;
        }
        .profile-header {
            background: linear-gradient(135deg, #1a1a2e, #0f3460);
            border-radius: 16px;
            padding: 2rem;
            color: #fff;
            margin-bottom: 2rem;
        }
        .profile-avatar {
            width: 100px;
            height: 100px;
            border-radius: 50%;
            border: 4px solid rgba(255, 255, 255, 0.3);
            object-fit: cover;
            background: #fff;
        }
        .profile-avatar-placeholder {
            width: 100px;
            height: 100px;
            border-radius: 50%;
            border: 4px solid rgba(255, 255, 255, 0.3);
            background: rgba(255, 255, 255, 0.1);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 2.5rem;
        }
        .upload-btn-wrapper {
            position: relative;
            overflow: hidden;
            display: inline-block;
        }
        .upload-btn-wrapper input[type=file] {
            position: absolute;
            left: 0;
            top: 0;
            opacity: 0;
            width: 100%;
            height: 100%;
            cursor: pointer;
        }
        .nav-tabs .nav-link {
            font-weight: 500;
            color: #495057;
            border: none;
            padding: 0.75rem 1.25rem;
            border-radius: 10px 10px 0 0;
        }
        .nav-tabs .nav-link:hover {
            border: none;
            color: #0d6efd;
        }
        .nav-tabs .nav-link.active {
            color: #0d6efd;
            background: #fff;
            border: none;
            border-bottom: 3px solid #0d6efd;
        }
        .tab-content {
            background: #fff;
            border-radius: 0 0 16px 16px;
        }
        .form-control {
            padding: 0.6rem 1rem;
            border-radius: 10px;
            border: 2px solid #e9ecef;
        }
        .form-control:focus {
            border-color: #0d6efd;
            box-shadow: none;
        }
        .form-control[readonly] {
            background-color: #f8f9fa;
        }
        .btn-save {
            padding: 0.6rem 2rem;
            border-radius: 10px;
            font-weight: 600;
        }
    </style>
}

<div class="profile-page py-4">
    <div class="container">
        <div class="profile-header">
            <div class="row align-items-center">
                <div class="col-auto">
                    <div class="position-relative">
                        <img src="@Model.ProfileImageUrl ?? "~/Content/images/default-avatar.png"" alt="Profile" class="profile-avatar"
                             onerror="this.style.display='none';this.nextElementSibling.style.display='flex';" />
                        <div class="profile-avatar-placeholder" style="display:none;">
                            <i class="fas fa-user"></i>
                        </div>
                        <div class="upload-btn-wrapper position-absolute bottom-0 end-0">
                            <button class="btn btn-light btn-sm rounded-circle shadow" title="Upload photo">
                                <i class="fas fa-camera"></i>
                            </button>
                            <input type="file" accept="image/*" id="profilePictureUpload" />
                        </div>
                    </div>
                </div>
                <div class="col">
                    <h4 class="fw-bold mb-1">@Model.FirstName @Model.LastName</h4>
                    <p class="mb-0 opacity-75"><i class="fas fa-envelope me-2"></i>@Model.Email</p>
                    <p class="mb-0 opacity-75"><i class="fas fa-phone me-2"></i>@Model.PhoneNumber</p>
                </div>
                <div class="col-auto text-end d-none d-md-block">
                    <small class="opacity-75">Member since</small>
                    <br />
                    <strong>@Model.MemberSince?.ToString("dd MMM yyyy")</strong>
                </div>
            </div>
        </div>

        <ul class="nav nav-tabs" id="profileTabs" role="tablist">
            <li class="nav-item" role="presentation">
                <button class="nav-link active" id="info-tab" data-bs-toggle="tab" data-bs-target="#info" type="button" role="tab">
                    <i class="fas fa-user me-1"></i>Profile Info
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link" id="password-tab" data-bs-toggle="tab" data-bs-target="#password" type="button" role="tab">
                    <i class="fas fa-key me-1"></i>Change Password
                </button>
            </li>
        </ul>

        <div class="tab-content">
            <div class="tab-pane fade show active p-4" id="info" role="tabpanel">
                @using (Html.BeginForm("UpdateProfile", "Account", FormMethod.Post, new { role = "form" }))
                {
                    @Html.AntiForgeryToken()

                    <div class="row g-3">
                        <div class="col-md-6">
                            @Html.LabelFor(m => m.FirstName, new { @class = "form-label fw-medium" })
                            @Html.TextBoxFor(m => m.FirstName, new { @class = "form-control" })
                            @Html.ValidationMessageFor(m => m.FirstName, "", new { @class = "invalid-feedback d-block" })
                        </div>
                        <div class="col-md-6">
                            @Html.LabelFor(m => m.LastName, new { @class = "form-label fw-medium" })
                            @Html.TextBoxFor(m => m.LastName, new { @class = "form-control" })
                            @Html.ValidationMessageFor(m => m.LastName, "", new { @class = "invalid-feedback d-block" })
                        </div>
                        <div class="col-md-6">
                            @Html.LabelFor(m => m.Email, new { @class = "form-label fw-medium" })
                            @Html.TextBoxFor(m => m.Email, new { @class = "form-control", @readonly = "readonly" })
                            <small class="text-muted">Email cannot be changed</small>
                        </div>
                        <div class="col-md-6">
                            @Html.LabelFor(m => m.PhoneNumber, new { @class = "form-label fw-medium" })
                            @Html.TextBoxFor(m => m.PhoneNumber, new { @class = "form-control", type = "tel" })
                            @Html.ValidationMessageFor(m => m.PhoneNumber, "", new { @class = "invalid-feedback d-block" })
                        </div>
                        <div class="col-md-6">
                            @Html.LabelFor(m => m.DateOfBirth, new { @class = "form-label fw-medium" })
                            @Html.TextBoxFor(m => m.DateOfBirth, new { @class = "form-control", type = "date" })
                            @Html.ValidationMessageFor(m => m.DateOfBirth, "", new { @class = "invalid-feedback d-block" })
                        </div>
                        <div class="col-md-6">
                            @Html.LabelFor(m => m.Gender, new { @class = "form-label fw-medium" })
                            @Html.DropDownListFor(m => m.Gender, new SelectList(new[] { "Male", "Female", "Other" }, Model.Gender), "-- Select --", new { @class = "form-select" })
                            @Html.ValidationMessageFor(m => m.Gender, "", new { @class = "invalid-feedback d-block" })
                        </div>
                        <div class="col-12">
                            <button type="submit" class="btn btn-primary btn-save">
                                <i class="fas fa-save me-2"></i>Save Changes
                            </button>
                        </div>
                    </div>
                }
            </div>

            <div class="tab-pane fade p-4" id="password" role="tabpanel">
                @using (Html.BeginForm("ChangePassword", "Account", FormMethod.Post, new { role = "form" }))
                {
                    @Html.AntiForgeryToken()

                    <div class="row g-3">
                        <div class="col-md-6">
                            @Html.Label("CurrentPassword", "Current Password", new { @class = "form-label fw-medium" })
                            @Html.Password("CurrentPassword", null, new { @class = "form-control", placeholder = "Enter current password" })
                            @Html.ValidationMessage("CurrentPassword", "", new { @class = "invalid-feedback d-block" })
                        </div>
                        <div class="col-md-6"></div>
                        <div class="col-md-6">
                            @Html.Label("NewPassword", "New Password", new { @class = "form-label fw-medium" })
                            @Html.Password("NewPassword", null, new { @class = "form-control", placeholder = "Enter new password" })
                            @Html.ValidationMessage("NewPassword", "", new { @class = "invalid-feedback d-block" })
                        </div>
                        <div class="col-md-6">
                            @Html.Label("ConfirmNewPassword", "Confirm New Password", new { @class = "form-label fw-medium" })
                            @Html.Password("ConfirmNewPassword", null, new { @class = "form-control", placeholder = "Confirm new password" })
                            @Html.ValidationMessage("ConfirmNewPassword", "", new { @class = "invalid-feedback d-block" })
                        </div>
                        <div class="col-12">
                            <button type="submit" class="btn btn-primary btn-save">
                                <i class="fas fa-key me-2"></i>Update Password
                            </button>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <!-- validation loaded from CDN in layout -->
    <script>
        $(document).ready(function () {
            // Profile picture upload preview
            $('#profilePictureUpload').on('change', function (e) {
                var file = e.target.files[0];
                if (file) {
                    var reader = new FileReader();
                    reader.onload = function (e) {
                        $('.profile-avatar').attr('src', e.target.result).show();
                        $('.profile-avatar-placeholder').hide();
                    };
                    reader.readAsDataURL(file);

                    // Auto-upload
                    var formData = new FormData();
                    formData.append('profilePicture', file);
                    $.ajax({
                        url: '/Account/UploadProfilePicture',
                        type: 'POST',
                        data: formData,
                        processData: false,
                        contentType: false,
                        success: function (response) {
                            if (response.success) {
                                location.reload();
                            }
                        }
                    });
                }
            });
        });
    </script>
}
