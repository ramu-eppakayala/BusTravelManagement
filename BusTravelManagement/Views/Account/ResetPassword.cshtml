@model BusTravelManagement.Models.ViewModels.ResetPasswordViewModel

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Reset Password - BusTravel Management";
}

@section Styles {
    <style>
        .reset-page {
            min-height: calc(100vh - 76px - 250px);
            display: flex;
            align-items: center;
            background: linear-gradient(135deg, #f5f7fa 0%, #e9edf5 100%);
        }
        .reset-card {
            border: none;
            border-radius: 16px;
            box-shadow: 0 10px 40px rgba(0, 0, 0, 0.08);
        }
        .reset-card .card-header {
            background: linear-gradient(135deg, #1a1a2e, #0f3460);
            color: #fff;
            border-radius: 16px 16px 0 0 !important;
            padding: 1.5rem;
            text-align: center;
            border: none;
        }
        .reset-card .card-body {
            padding: 2rem;
        }
        .reset-card .form-control {
            padding: 0.7rem 1rem;
            border-radius: 10px;
            border: 2px solid #e9ecef;
            transition: border-color 0.3s;
        }
        .reset-card .form-control:focus {
            border-color: #0d6efd;
            box-shadow: none;
        }
        .reset-card .btn-submit {
            padding: 0.7rem;
            border-radius: 10px;
            font-weight: 600;
        }
        .reset-icon {
            font-size: 3rem;
            color: #198754;
            margin-bottom: 1rem;
        }
    </style>
}

<div class="reset-page py-5">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-5 col-lg-4">
                <div class="card reset-card">
                    <div class="card-header">
                        <h4><i class="fas fa-key me-2"></i>Reset Password</h4>
                        <p class="mb-0 small opacity-75">Enter your new password</p>
                    </div>
                    <div class="card-body text-center">
                        <div class="reset-icon">
                            <i class="fas fa-check-circle"></i>
                        </div>
                        <p class="text-muted mb-4">Please choose a strong password that you haven't used before.</p>

                        @Html.ValidationSummary(true, "", new { @class = "alert alert-danger", role = "alert" })

                        @if (TempData["ErrorMessage"] != null)
                        {
                            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                                <i class="fas fa-exclamation-circle me-2"></i>@TempData["ErrorMessage"]
                                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                            </div>
                        }

                        @using (Html.BeginForm("ResetPassword", "Account", FormMethod.Post, new { role = "form" }))
                        {
                            @Html.AntiForgeryToken()
                            @Html.HiddenFor(m => m.Token)

                            <div class="mb-3 text-start">
                                @Html.LabelFor(m => m.Password, new { @class = "form-label fw-medium" })
                                <div class="input-group">
                                    <span class="input-group-text"><i class="fas fa-lock"></i></span>
                                    @Html.PasswordFor(m => m.Password, new { @class = "form-control", placeholder = "New password" })
                                </div>
                                @Html.ValidationMessageFor(m => m.Password, "", new { @class = "invalid-feedback d-block" })
                            </div>

                            <div class="mb-4 text-start">
                                @Html.LabelFor(m => m.ConfirmPassword, new { @class = "form-label fw-medium" })
                                <div class="input-group">
                                    <span class="input-group-text"><i class="fas fa-check-double"></i></span>
                                    @Html.PasswordFor(m => m.ConfirmPassword, new { @class = "form-control", placeholder = "Confirm new password" })
                                </div>
                                @Html.ValidationMessageFor(m => m.ConfirmPassword, "", new { @class = "invalid-feedback d-block" })
                            </div>

                            <button type="submit" class="btn btn-primary btn-submit w-100">
                                <i class="fas fa-save me-2"></i>Reset Password
                            </button>
                        }

                        <p class="mb-0 mt-3">
                            @Html.ActionLink("Back to Login", "Login", "Account", null, new { @class = "text-decoration-none" })
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <!-- validation loaded from CDN in layout -->
}
