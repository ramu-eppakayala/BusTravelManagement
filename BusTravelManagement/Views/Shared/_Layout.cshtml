@using System.Linq;
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="csrf-token" content="@GetAntiForgeryToken()" />
    <title>@ViewBag.Title - BusTravel Management</title>
    <link href="@("https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css")" rel="stylesheet" />
    <link rel="stylesheet" href="@("https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css")" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
    <link href="~/Content/css/site.css" rel="stylesheet" />
    @RenderSection("Styles", required: false)
    <style>
        :root {
            --primary: #0d6efd;
            --primary-dark: #0b5ed7;
            --secondary: #6c757d;
        }
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            padding-top: 76px;
        }
        .navbar-brand {
            font-weight: 700;
            font-size: 1.5rem;
        }
        .navbar-brand i {
            color: #ffc107;
        }
        .navbar .nav-link {
            font-weight: 500;
            padding: 0.5rem 1rem !important;
            border-radius: 0.375rem;
            transition: all 0.2s;
        }
        .navbar .nav-link:hover {
            background-color: rgba(255, 255, 255, 0.1);
        }
        .navbar .nav-link.active {
            background-color: rgba(255, 255, 255, 0.15);
        }
        .notification-bell {
            position: relative;
            cursor: pointer;
        }
        .notification-bell .badge {
            position: absolute;
            top: -2px;
            right: -6px;
            font-size: 0.6rem;
            padding: 0.2em 0.45em;
        }
        .notification-dropdown {
            width: 320px;
            max-height: 400px;
            overflow-y: auto;
            padding: 0;
        }
        .notification-dropdown .dropdown-header {
            background-color: #f8f9fa;
            font-weight: 600;
            position: sticky;
            top: 0;
            z-index: 1;
        }
        .notification-item {
            padding: 0.75rem 1rem;
            border-bottom: 1px solid #e9ecef;
            transition: background-color 0.2s;
        }
        .notification-item:hover {
            background-color: #f8f9fa;
        }
        .notification-item.unread {
            background-color: #f0f7ff;
        }
        .notification-item .notification-time {
            font-size: 0.75rem;
            color: #6c757d;
        }
        .toast-container {
            position: fixed;
            top: 80px;
            right: 20px;
            z-index: 9999;
        }
        .toast-container .toast {
            min-width: 300px;
        }
        .footer {
            background-color: #1a1a2e;
            color: #c0c0d0;
        }
        .footer a {
            color: #a0a0c0;
            text-decoration: none;
            transition: color 0.2s;
        }
        .footer a:hover {
            color: #ffffff;
        }
        .footer h5 {
            color: #ffffff;
            font-weight: 600;
        }
        .footer .social-icon {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 36px;
            height: 36px;
            border-radius: 50%;
            background-color: rgba(255, 255, 255, 0.1);
            transition: background-color 0.2s;
        }
        .footer .social-icon:hover {
            background-color: rgba(255, 255, 255, 0.2);
        }
        .footer-bottom {
            border-top: 1px solid rgba(255, 255, 255, 0.1);
        }
        .dropdown-menu {
            border: none;
            box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.15);
        }
        .user-avatar {
            width: 32px;
            height: 32px;
            border-radius: 50%;
            object-fit: cover;
        }
        @@media (max-width: 991.98px) {
            .navbar .nav-link {
                padding: 0.5rem 0 !important;
            }
        }
    </style>
</head>
<body>
    @{
        var isAuthenticated = User.Identity.IsAuthenticated;
        var userName = isAuthenticated ? User.Identity.Name : "";
        var userRoles = isAuthenticated
            ? ((System.Security.Claims.ClaimsPrincipal)User)
                .FindAll(System.Security.Claims.ClaimTypes.Role)
                .Select(c => c.Value)
                .ToArray()
            : new string[0];
    }

    <nav class="navbar navbar-expand-lg navbar-dark bg-dark fixed-top shadow">
        <div class="container">
            @Html.ActionLink("BusTravel", "Index", "Home", null, new { @class = "navbar-brand" })
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavbar">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="mainNavbar">
                <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                    <li class="nav-item">
                        @Html.ActionLink("Home", "Index", "Home", null, new { @class = "nav-link" })
                    </li>
                    <li class="nav-item">
                        @Html.ActionLink("Search", "Index", "Search", null, new { @class = "nav-link" })
                    </li>
                    @if (isAuthenticated)
                    {
                        <li class="nav-item">
                            @Html.ActionLink("My Bookings", "MyBookings", "Account", null, new { @class = "nav-link" })
                        </li>
                        <li class="nav-item">
                            @Html.ActionLink("Profile", "Profile", "Account", null, new { @class = "nav-link" })
                        </li>
                    }
                    @if (userRoles.Any(r => r == "Admin" || r == "SuperAdmin"))
                    {
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">
                                <i class="fas fa-shield-alt"></i> Admin
                            </a>
                            <ul class="dropdown-menu">
                                <li>@Html.ActionLink("Dashboard", "Dashboard", "Admin", null, new { @class = "dropdown-item" })</li>
                                <li>@Html.ActionLink("Users", "Users", "Admin", null, new { @class = "dropdown-item" })</li>
                                <li>@Html.ActionLink("Operators", "Operators", "Admin", null, new { @class = "dropdown-item" })</li>
                                <li>@Html.ActionLink("Coupons", "Coupons", "Admin", null, new { @class = "dropdown-item" })</li>
                                <li>@Html.ActionLink("Reviews", "Reviews", "Admin", null, new { @class = "dropdown-item" })</li>
                            </ul>
                        </li>
                    }
                    @if (userRoles.Any(r => r == "Operator"))
                    {
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">
                                <i class="fas fa-bus"></i> Operator
                            </a>
                            <ul class="dropdown-menu">
                                <li>@Html.ActionLink("Dashboard", "Dashboard", "Operator", null, new { @class = "dropdown-item" })</li>
                                <li>@Html.ActionLink("Buses", "Buses", "Operator", null, new { @class = "dropdown-item" })</li>
                                <li>@Html.ActionLink("Schedules", "Schedules", "Operator", null, new { @class = "dropdown-item" })</li>
                            </ul>
                        </li>
                    }
                </ul>
                <ul class="navbar-nav ms-auto align-items-lg-center">
                    @if (isAuthenticated)
                    {
                        <li class="nav-item dropdown">
                            <a class="nav-link notification-bell" href="#" role="button" data-bs-toggle="dropdown" id="notificationDropdown">
                                <i class="fas fa-bell fs-5"></i>
                                <span class="badge bg-danger rounded-pill d-none" id="notificationBadge">0</span>
                            </a>
                            <div class="dropdown-menu dropdown-menu-end notification-dropdown" aria-labelledby="notificationDropdown">
                                <div class="dropdown-header d-flex justify-content-between align-items-center">
                                    <span>Notifications</span>
                                    <a href="#" class="text-decoration-none small" id="markAllRead">Mark all read</a>
                                </div>
                                <div id="notificationList">
                                    <div class="text-center text-muted py-3 small">No notifications</div>
                                </div>
                            </div>
                        </li>
                        <li class="nav-item dropdown ms-2">
                            <a class="nav-link dropdown-toggle d-flex align-items-center" href="#" role="button" data-bs-toggle="dropdown">
                                <img src="~/Content/images/default-avatar.png" alt="Avatar" class="user-avatar me-1"
                                     onerror="this.style.display='none';this.nextElementSibling.style.display='inline-flex';" />
                                <i class="fas fa-user-circle fs-5" style="display:none;"></i>
                                <span class="ms-1 d-none d-lg-inline">@userName</span>
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end">
                                <li>@Html.ActionLink("My Profile", "Profile", "Account", null, new { @class = "dropdown-item" })</li>
                                <li>@Html.ActionLink("My Bookings", "MyBookings", "Account", null, new { @class = "dropdown-item" })</li>
                                <li><hr class="dropdown-divider" /></li>
                                <li>
                                    @using (Html.BeginForm("Logout", "Account", FormMethod.Post, new { id = "logoutForm", style = "display:inline" }))
                                    {
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="dropdown-item border-0 bg-transparent w-100 text-start">Logout</button>
                                    }
                                </li>
                            </ul>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item">
                            @Html.ActionLink("Login", "Login", "Account", null, new { @class = "nav-link" })
                        </li>
                        <li class="nav-item">
                            @Html.ActionLink("Register", "Register", "Account", null, new { @class = "nav-link btn btn-primary btn-sm text-white ms-lg-2 px-3" })
                        </li>
                    }
                </ul>
            </div>
        </div>
    </nav>

    <main role="main" class="pb-4">
        @RenderBody()
    </main>

    <footer class="footer pt-5 pb-3 mt-auto">
        <div class="container">
            <div class="row g-4">
                <div class="col-lg-4 col-md-6">
                    <h5 class="mb-3">BusTravel</h5>
                    <p class="small">India's most trusted bus booking platform. Travel safe, travel smart with BusTravel Management.</p>
                    <div class="d-flex gap-2 mt-3">
                        <a href="#" class="social-icon" title="Facebook"><i class="fab fa-facebook-f"></i></a>
                        <a href="#" class="social-icon" title="Twitter"><i class="fab fa-twitter"></i></a>
                        <a href="#" class="social-icon" title="Instagram"><i class="fab fa-instagram"></i></a>
                        <a href="#" class="social-icon" title="YouTube"><i class="fab fa-youtube"></i></a>
                    </div>
                </div>
                <div class="col-lg-2 col-md-6">
                    <h5 class="mb-3">Quick Links</h5>
                    <ul class="list-unstyled small">
                        <li class="mb-2">@Html.ActionLink("About Us", "About", "Home")</li>
                        <li class="mb-2">@Html.ActionLink("Contact Us", "Contact", "Home")</li>
                        <li class="mb-2">@Html.ActionLink("Terms & Conditions", "Terms", "Home")</li>
                        <li class="mb-2">@Html.ActionLink("Privacy Policy", "Privacy", "Home")</li>
                        <li class="mb-2">@Html.ActionLink("FAQ", "FAQ", "Home")</li>
                    </ul>
                </div>
                <div class="col-lg-3 col-md-6">
                    <h5 class="mb-3">Contact Info</h5>
                    <ul class="list-unstyled small">
                        <li class="mb-2"><i class="fas fa-map-marker-alt me-2"></i> 123 Travel Street, Mumbai, India</li>
                        <li class="mb-2"><i class="fas fa-phone me-2"></i> +91 1800-123-4567</li>
                        <li class="mb-2"><i class="fas fa-envelope me-2"></i> support@bustravel.com</li>
                    </ul>
                </div>
                <div class="col-lg-3 col-md-6">
                    <h5 class="mb-3">Download App</h5>
                    <p class="small">Get the BusTravel app for a better experience.</p>
                    <div class="d-flex flex-column gap-2">
                        <a href="#" class="btn btn-outline-light btn-sm"><i class="fab fa-google-play me-2"></i>Google Play</a>
                        <a href="#" class="btn btn-outline-light btn-sm"><i class="fab fa-apple me-2"></i>App Store</a>
                    </div>
                </div>
            </div>
            <div class="footer-bottom pt-3 mt-4 text-center">
                <p class="small mb-0">&copy; @DateTime.Now.Year BusTravel Management. All rights reserved.</p>
            </div>
        </div>
    </footer>

    <div class="toast-container" id="toastContainer">
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="toast align-items-center text-white bg-success border-0 show" role="alert">
                <div class="d-flex">
                    <div class="toast-body">
                        <i class="fas fa-check-circle me-2"></i>@TempData["SuccessMessage"]
                    </div>
                    <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button>
                </div>
            </div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="toast align-items-center text-white bg-danger border-0 show" role="alert">
                <div class="d-flex">
                    <div class="toast-body">
                        <i class="fas fa-exclamation-circle me-2"></i>@TempData["ErrorMessage"]
                    </div>
                    <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button>
                </div>
            </div>
        }
        @if (TempData["InfoMessage"] != null)
        {
            <div class="toast align-items-center text-white bg-info border-0 show" role="alert">
                <div class="d-flex">
                    <div class="toast-body">
                        <i class="fas fa-info-circle me-2"></i>@TempData["InfoMessage"]
                    </div>
                    <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button>
                </div>
            </div>
        }
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.19.5/jquery.validate.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validation-unobtrusive/4.0.0/jquery.validate.unobtrusive.min.js"></script>
    @RenderSection("Scripts", required: false)
    <script>
        // Initialize Bootstrap toasts
        document.addEventListener('DOMContentLoaded', function () {
            var toastElList = [].slice.call(document.querySelectorAll('.toast'));
            toastElList.forEach(function (el) {
                var toast = new bootstrap.Toast(el, { autohide: true, delay: 5000 });
                toast.show();
            });

            // Anti-forgery token for AJAX
            var csrfToken = document.querySelector('meta[name="csrf-token"]');
            if (csrfToken) {
                $(document).ajaxSend(function (e, xhr, options) {
                    if (!options.crossDomain) {
                        xhr.setRequestHeader('X-CSRF-TOKEN', csrfToken.getAttribute('content'));
                    }
                });
            }
        });
    </script>
</body>
</html>

@functions {
    private string GetAntiForgeryToken()
    {
        var context = System.Web.HttpContext.Current;
        if (context != null)
        {
            var cookie = context.Request.Cookies["__RequestVerificationToken"];
            if (cookie != null)
            {
                return cookie.Value;
            }
        }
        return string.Empty;
    }
}
