@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Privacy Policy - BusTravel Management";
}

@section Styles {
    <style>
        .privacy-section { padding: 4rem 0; }
        .privacy-section h2 { font-weight: 700; color: #1a1a2e; margin-bottom: 2rem; }
        .privacy-section h5 { font-weight: 600; color: #1a1a2e; margin-top: 1.5rem; }
        .privacy-section p, .privacy-section li { color: #6c757d; line-height: 1.8; }
    </style>
}

<div class="privacy-section">
    <div class="container">
        <div class="row">
            <div class="col-lg-10 mx-auto">
                <h2>Privacy Policy</h2>
                <p>Your privacy is important to us. This policy outlines how we collect, use, and protect your information.</p>
                <h5>1. Information We Collect</h5>
                <p>We collect personal information such as name, email, phone number, and travel preferences when you create an account or make a booking.</p>
                <h5>2. How We Use Your Information</h5>
                <p>Your information is used to process bookings, provide customer support, send travel updates, and improve our services.</p>
                <h5>3. Data Security</h5>
                <p>We implement industry-standard security measures to protect your data from unauthorized access.</p>
                <h5>4. Third-Party Sharing</h5>
                <p>We do not sell your personal information. Data is shared only with bus operators and payment processors as necessary to fulfill your booking.</p>
                <h5>5. Contact</h5>
                <p>For privacy-related inquiries, contact us at privacy@bustravel.com.</p>
            </div>
        </div>
    </div>
</div>
