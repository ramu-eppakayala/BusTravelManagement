@model BusTravelManagement.Models.ViewModels.CreateScheduleViewModel
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Create Schedule - BusTravel Management";
}

@section Styles {
    <style>
        .form-section { padding: 2rem 0; background: #f8f9fa; min-height: calc(100vh - 76px - 250px); }
        .form-card { border: none; border-radius: 12px; box-shadow: 0 2px 12px rgba(0,0,0,0.06); }
        .form-card .card-header { background: linear-gradient(135deg, #1a1a2e, #0f3460); color: #fff; border-radius: 12px 12px 0 0 !important; padding: 1.25rem 1.5rem; }
        .form-card .card-body { padding: 2rem; }
        .form-card .form-label { font-weight: 600; }
        .form-card .form-control, .form-card .form-select { padding: 0.6rem 1rem; border-radius: 8px; border: 2px solid #e9ecef; }
        .form-card .form-control:focus, .form-card .form-select:focus { border-color: #0d6efd; box-shadow: none; }
    </style>
}

<div class="form-section">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-8">
                <div class="card form-card">
                    <div class="card-header">
                        <h5><i class="fas fa-calendar-plus me-2"></i>Create Schedule</h5>
                    </div>
                    <div class="card-body">
                        @using (Html.BeginForm("CreateSchedule", "Operator", FormMethod.Post, new { role = "form" }))
                        {
                            @Html.AntiForgeryToken()
                            @Html.ValidationSummary(true, "", new { @class = "alert alert-danger" })

                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label class="form-label">Select Bus</label>
                                    @Html.DropDownListFor(m => m.BusId, (SelectList)ViewBag.Buses, "Select Bus", new { @class = "form-select" })
                                    @Html.ValidationMessageFor(m => m.BusId, "", new { @class = "text-danger small" })
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label">Route</label>
                                    @Html.DropDownListFor(m => m.RouteId, (SelectList)ViewBag.Routes, "Select Route", new { @class = "form-select" })
                                    @Html.ValidationMessageFor(m => m.RouteId, "", new { @class = "text-danger small" })
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label">Departure Time</label>
                                    @Html.TextBoxFor(m => m.DepartureTime, "{0:hh\\:mm}", new { @class = "form-control", type = "time" })
                                    @Html.ValidationMessageFor(m => m.DepartureTime, "", new { @class = "text-danger small" })
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label">Arrival Time</label>
                                    @Html.TextBoxFor(m => m.ArrivalTime, "{0:hh\\:mm}", new { @class = "form-control", type = "time" })
                                    @Html.ValidationMessageFor(m => m.ArrivalTime, "", new { @class = "text-danger small" })
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label">Base Fare</label>
                                    @Html.TextBoxFor(m => m.BaseFare, new { @class = "form-control", type = "number", step = "0.01" })
                                    @Html.ValidationMessageFor(m => m.BaseFare, "", new { @class = "text-danger small" })
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label">Duration (minutes)</label>
                                    @Html.TextBoxFor(m => m.DurationMinutes, new { @class = "form-control", type = "number", min = "1", max = "1440" })
                                    @Html.ValidationMessageFor(m => m.DurationMinutes, "", new { @class = "text-danger small" })
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label">Available Days</label>
                                    <div>
                                        <input type="hidden" name="DaysOfWeek" id="createScheduleDaysOfWeek" />
                                        @foreach (var day in new[] { "Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday" })
                                        {
                                            <div class="form-check form-check-inline">
                                                <input type="checkbox" name="DaySelection" value="@day" class="form-check-input" id="day_@day" />
                                                <label class="form-check-label small" for="day_@day">@day</label>
                                            </div>
                                        }
                                    </div>
                                </div>
                            </div>

                            <div class="mt-4 text-end">
                                <a href="@Url.Action("Schedules", "Operator")" class="btn btn-outline-secondary me-2">Cancel</a>
                                <button type="submit" class="btn btn-primary"><i class="fas fa-save me-2"></i>Create Schedule</button>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('form[action="/Operator/CreateSchedule"]').on('submit', function () {
                var days = [];
                $('input[name="DaySelection"]:checked').each(function () {
                    days.push($(this).val());
                });
                $('#createScheduleDaysOfWeek').val(days.join(','));
            });
        });
    </script>
}
