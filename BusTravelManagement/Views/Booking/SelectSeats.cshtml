@model BusTravelManagement.Models.ViewModels.BusDetailViewModel

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Select Seats - BusTravel Management";
}

@section Styles {
    <style>
        .seats-page {
            background: #f8f9fa;
            min-height: calc(100vh - 76px - 250px);
        }
        .bus-summary-card {
            background: linear-gradient(135deg, #1a1a2e, #0f3460);
            border-radius: 16px;
            padding: 1.25rem 1.5rem;
            color: #fff;
            margin-bottom: 1.5rem;
        }
        .bus-summary-card .bus-op {
            font-weight: 700;
            font-size: 1.2rem;
        }
        .bus-summary-card .bus-info {
            opacity: 0.85;
            font-size: 0.9rem;
        }
        .bus-summary-card .route-info {
            font-size: 1.1rem;
            font-weight: 600;
        }
        .bus-summary-card .route-info .arrow {
            color: #ffc107;
            margin: 0 0.75rem;
        }
        .seat-layout-wrapper {
            background: #fff;
            border-radius: 16px;
            box-shadow: 0 2px 12px rgba(0,0,0,0.06);
            padding: 2rem;
            min-height: 400px;
        }
        .seat-legend {
            display: flex;
            gap: 1.5rem;
            flex-wrap: wrap;
            margin-bottom: 1.5rem;
        }
        .seat-legend .legend-item {
            display: flex;
            align-items: center;
            gap: 0.5rem;
            font-size: 0.85rem;
        }
        .seat-legend .legend-box {
            width: 24px;
            height: 24px;
            border-radius: 6px;
            border: 2px solid transparent;
        }
        .seat-legend .legend-box.available {
            background: #d1fae5;
            border-color: #059669;
        }
        .seat-legend .legend-box.booked {
            background: #fee2e2;
            border-color: #dc2626;
        }
        .seat-legend .legend-box.ladies {
            background: #fce7f3;
            border-color: #ec4899;
        }
        .seat-legend .legend-box.selected {
            background: #dbeafe;
            border-color: #2563eb;
        }
        .summary-sidebar {
            background: #fff;
            border-radius: 16px;
            box-shadow: 0 2px 12px rgba(0,0,0,0.06);
            padding: 1.5rem;
            position: sticky;
            top: 90px;
        }
        .summary-sidebar h6 {
            font-weight: 700;
            color: #1a1a2e;
            border-bottom: 1px solid #e9ecef;
            padding-bottom: 0.75rem;
            margin-bottom: 1rem;
        }
        .summary-sidebar .selected-seat {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 0.5rem 0;
            border-bottom: 1px solid #f8f9fa;
        }
        .summary-sidebar .selected-seat .seat-name {
            font-weight: 600;
        }
        .summary-sidebar .selected-seat .seat-price {
            color: #0d6efd;
            font-weight: 600;
        }
        .summary-sidebar .total-amount {
            font-size: 1.3rem;
            font-weight: 800;
            color: #1a1a2e;
        }
        .btn-continue {
            padding: 0.75rem;
            border-radius: 10px;
            font-weight: 700;
        }
        .point-selector .form-select {
            border-radius: 10px;
            border: 2px solid #e9ecef;
            padding: 0.6rem 1rem;
        }
        .point-selector .form-select:focus {
            border-color: #0d6efd;
            box-shadow: none;
        }
        #seat-selector-root {
            min-height: 300px;
        }
        @@media (max-width: 768px) {
            .bus-summary-card .route-info { font-size: 1rem; }
            .seat-layout-wrapper { padding: 1rem; }
        }
    </style>
}

<div class="seats-page py-4">
    <div class="container">
        <!-- Bus Summary -->
        <div class="bus-summary-card">
            <div class="row align-items-center">
                <div class="col-md-4 mb-2 mb-md-0">
                    <div class="bus-op">
                        <i class="fas fa-bus me-2"></i>@Model.OperatorName
                    </div>
                    <div class="bus-info">
                        @Model.BusNumber | @(Model.IsAC ? "AC" : "Non-AC") @(Model.IsSleeper ? "Sleeper" : "Seater")
                    </div>
                </div>
                <div class="col-md-4 mb-2 mb-md-0">
                    <div class="route-info">
                        @Model.SourceCity <i class="fas fa-arrow-right arrow"></i> @Model.DestinationCity
                    </div>
                    <div class="bus-info">
                        @Model.JourneyDate.ToString("dd MMM yyyy, dddd") | @Model.DepartureTime - @Model.ArrivalTime
                    </div>
                </div>
                <div class="col-md-4 text-md-end">
                    <div class="bus-info">
                        <i class="fas fa-chair me-1"></i>Available: <strong>@Model.AvailableSeats</strong> seats
                    </div>
                </div>
            </div>
        </div>

        <!-- Seat Legend -->
        <div class="seat-legend">
            <div class="legend-item">
                <div class="legend-box available"></div>
                <span>Available</span>
            </div>
            <div class="legend-item">
                <div class="legend-box booked"></div>
                <span>Booked</span>
            </div>
            <div class="legend-item">
                <div class="legend-box ladies"></div>
                <span>Ladies</span>
            </div>
            <div class="legend-item">
                <div class="legend-box selected"></div>
                <span>Selected</span>
            </div>
        </div>

        <div class="row">
            <!-- Seat Selector -->
            <div class="col-lg-8 mb-4">
                <div class="seat-layout-wrapper">
                    <!-- React component mount point -->
                    <div id="seat-selector-root"></div>
                </div>

                <!-- Boarding/Dropping Points -->
                <div class="row g-3 mt-3">
                    <div class="col-md-6">
                        <div class="point-selector">
                            <label class="form-label fw-medium">Boarding Point</label>
                            <select class="form-select" id="boardingPointSelect">
                                <option value="">-- Select Boarding Point --</option>
                                @if (Model.BoardingPoints != null)
                                {
                                    foreach (var point in Model.BoardingPoints)
                                    {
                                        <option value="@point.Id">
                                            @point.Name - @point.PickupTime
                                        </option>
                                    }
                                }
                            </select>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="point-selector">
                            <label class="form-label fw-medium">Dropping Point</label>
                            <select class="form-select" id="droppingPointSelect">
                                <option value="">-- Select Dropping Point --</option>
                                @if (Model.DroppingPoints != null)
                                {
                                    foreach (var point in Model.DroppingPoints)
                                    {
                                        <option value="@point.Id">
                                            @point.Name - @point.DropTime
                                        </option>
                                    }
                                }
                            </select>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Selected Seats Summary -->
            <div class="col-lg-4">
                <div class="summary-sidebar" id="summarySidebar">
                    <h6><i class="fas fa-shopping-cart me-2"></i>Selected Seats</h6>
                    <div id="selectedSeatsList">
                        <p class="text-muted small mb-0 text-center py-3">
                            <i class="fas fa-chair me-1"></i>No seats selected yet
                        </p>
                    </div>
                    <hr />
                    <div class="d-flex justify-content-between mb-2">
                        <span>Seats:</span>
                        <span id="selectedSeatsCount">0</span>
                    </div>
                    <div class="d-flex justify-content-between mb-3">
                        <span>Fare per seat:</span>
                        <span>₹@Model.BaseFare.ToString("N2")</span>
                    </div>
                    <div class="d-flex justify-content-between">
                        <span class="total-amount">Total Amount:</span>
                        <span class="total-amount" id="totalAmount">₹0</span>
                    </div>
                    <button class="btn btn-primary btn-continue w-100 mt-3" id="continueBtn" disabled>
                        <i class="fas fa-arrow-right me-2"></i>CONTINUE
                    </button>
                    <p class="text-muted small text-center mt-2 mb-0">
                        <i class="fas fa-info-circle me-1"></i>Select seats to continue
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            // Communication with React component (when implemented)
            window.addEventListener('message', function (event) {
                if (event.data.type === 'SEATS_SELECTED') {
                    updateSelectedSeats(event.data.seats);
                }
            });

            window.updateSelectedSeats = function (seats) {
                var list = $('#selectedSeatsList');
                var count = seats.length;
                var perSeatFare = @Model.BaseFare;
                var total = count * perSeatFare;

                $('#selectedSeatsCount').text(count);
                $('#totalAmount').text('₹' + total.toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 }));

                if (count === 0) {
                    list.html('<p class="text-muted small mb-0 text-center py-3"><i class="fas fa-chair me-1"></i>No seats selected yet</p>');
                    $('#continueBtn').prop('disabled', true);
                    return;
                }

                var html = '';
                seats.forEach(function (seat) {
                    html += '<div class="selected-seat">' +
                        '<span class="seat-name"><i class="fas fa-chair text-primary me-1"></i>' + seat.name + '</span>' +
                        '<span class="seat-price">₹' + perSeatFare.toLocaleString('en-IN', { minimumFractionDigits: 2 }) + '</span>' +
                        '</div>';
                });
                list.html(html);
                $('#continueBtn').prop('disabled', false);
            };

            // Continue button click
            $('#continueBtn').on('click', function () {
                var boardingPoint = $('#boardingPointSelect').val();
                var droppingPoint = $('#droppingPointSelect').val();

                if (!boardingPoint) {
                    alert('Please select a boarding point.');
                    return;
                }
                if (!droppingPoint) {
                    alert('Please select a dropping point.');
                    return;
                }

                // Get selected seats from React component via postMessage
                // Redirect to passenger details
                var selectedSeats = [];
                // In production, this data would come from the React component
                window.location.href = '/Booking/PassengerDetails?scheduleId=@Model.ScheduleId&boardingPoint=' + boardingPoint + '&droppingPoint=' + droppingPoint + '&seats=' + selectedSeats.join(',');
            });

            // Boarding/Dropping point validation
            $('#boardingPointSelect, #droppingPointSelect').on('change', function () {
                validateSelection();
            });

            function validateSelection() {
                var hasBoarding = $('#boardingPointSelect').val();
                var hasDropping = $('#droppingPointSelect').val();
                // Enable continue only if seats selected and points chosen
            }
        });
    </script>
}
