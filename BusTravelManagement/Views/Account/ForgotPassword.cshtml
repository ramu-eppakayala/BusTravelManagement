
@model BusTravelManagement.Models.ViewModels.ForgotPasswordViewModel

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Forgot Password - BusTravel Management";
}

@section Styles {
    <style>
        .forgot-page {
            min-height: calc(100vh - 76px - 250px);
            display: flex;
            align-items: center;
            background: linear-gradient(135deg, #f5f7fa 0%, #e9edf5 100%);
        }

        .forgot-card {
            border: none;
            border-radius: 16px;
            box-shadow: 0 10px 40px rgba(0, 0, 0, 0.08);
        }

            .forgot-card .card-header {
                background: linear-gradient(135deg, #1a1a2e, #0f3460);
                color: #fff;
                border-radius: 16px 16px 0 0 !important;
                padding: 1.5rem;
                text-align: center;
                border: none;
            }

            .forgot-card .card-body {
                padding: 2rem;
            }

            .forgot-card .form-control {
                padding: 0.7rem 1rem;
                border-radius: 10px;
                border: 2px solid #e9ecef;
                transition: border-color 0.3s;
            }

                .forgot-card .form-control:focus {
                    border-color: #0d6efd;
                    box-shadow: none;
                }

            .forgot-card .btn-submit {
                padding: 0.7rem;
                border-radius: 10px;
                font-weight: 600;
            }

        .forgot-icon {
            font-size: 3rem;
            color: #0d6efd;
            margin-bottom: 1rem;
        }
    </style>
}

<div class="forgot-page py-5">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-5 col-lg-4">
                <div class="card forgot-card">
                    <div class="card-header">
                        <h4><i class="fas fa-key me-2"></i>Forgot Password</h4>
                        <p class="mb-0 small opacity-75">We'll send you a reset link</p>
                    </div>
                    <div class="card-body text-center">
                        <div class="forgot-icon">
                            <i class="fas fa-lock"></i>
                        </div>
                        <p class="text-muted mb-4">
                            Enter your registered email address and we'll send you a link to reset your password.
                        </p>

                        @Html.ValidationSummary(true, "", new { @class = "alert alert-danger", role = "alert" })

                        @if (TempData["SuccessMessage"] != null)
                        {
                            <div class="alert alert-success alert-dismissible fade show" role="alert">
                                <i class="fas fa-check-circle me-2"></i>@TempData["SuccessMessage"]
                                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                            </div>
                        }

                        @using (Html.BeginForm("ForgotPassword", "Account", FormMethod.Post, new { role = "form" }))
                        {
                            @Html.AntiForgeryToken()

                            <div class="mb-3 text-start">
                                @Html.LabelFor(m => m.Email, new { @class = "form-label fw-medium" })
                                <div class="input-group">
                                    <span class="input-group-text"><i class="fas fa-envelope"></i></span>
                                    @Html.TextBoxFor(m => m.Email, new { @class = "form-control", placeholder = "you@example.com" })
                                </div>
                                @Html.ValidationMessageFor(m => m.Email, "", new { @class = "invalid-feedback d-block" })
                            </div>

                            <button type="submit" class="btn btn-primary btn-submit w-100">
                                <i class="fas fa-paper-plane me-2"></i>Send Reset Link
                            </button>
                        }

                        <p class="mb-0 mt-3">
                            @Html.ActionLink("Back to Login", "Login", "Account", null, new { @class = "text-decoration-none" })
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <!-- validation loaded from CDN in layout -->
}
