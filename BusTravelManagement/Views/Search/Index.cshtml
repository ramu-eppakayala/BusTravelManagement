@using System.Linq
@model BusTravelManagement.Models.ViewModels.SearchResultViewModel

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Search Results - BusTravel Management";
}

@section Styles {
    <style>
        .search-page {
            background: #f8f9fa;
            min-height: calc(100vh - 76px - 250px);
        }
        .criteria-bar {
            background: linear-gradient(135deg, #1a1a2e, #0f3460);
            border-radius: 12px;
            padding: 1rem 1.5rem;
            color: #fff;
            margin-bottom: 1.5rem;
        }
        .criteria-bar .route {
            font-size: 1.2rem;
            font-weight: 700;
        }
        .criteria-bar .route .arrow {
            color: #ffc107;
            margin: 0 0.75rem;
        }
        .criteria-bar .date-badge {
            background: rgba(255,255,255,0.15);
            padding: 0.4rem 1rem;
            border-radius: 8px;
            font-size: 0.9rem;
        }
        .filter-card {
            border: none;
            border-radius: 12px;
            box-shadow: 0 2px 12px rgba(0,0,0,0.06);
            position: sticky;
            top: 90px;
        }
        .filter-card .card-header {
            background: #fff;
            border-bottom: 1px solid #e9ecef;
            font-weight: 700;
            border-radius: 12px 12px 0 0 !important;
        }
        .filter-card .card-body {
            padding: 1.25rem;
        }
        .filter-section {
            margin-bottom: 1.25rem;
        }
        .filter-section:last-child {
            margin-bottom: 0;
        }
        .filter-section .filter-title {
            font-weight: 600;
            font-size: 0.85rem;
            text-transform: uppercase;
            color: #6c757d;
            margin-bottom: 0.5rem;
        }
        .filter-section .form-check-label {
            font-size: 0.9rem;
        }
        .filter-section .form-check-input:checked {
            background-color: #0d6efd;
            border-color: #0d6efd;
        }
        .filter-section .price-range {
            display: flex;
            gap: 0.5rem;
            align-items: center;
        }
        .filter-section .price-range input {
            width: 80px;
            padding: 0.3rem 0.5rem;
            border-radius: 6px;
            border: 1px solid #dee2e6;
        }
        .bus-card {
            border: none;
            border-radius: 12px;
            box-shadow: 0 2px 12px rgba(0,0,0,0.06);
            transition: all 0.3s;
            margin-bottom: 1rem;
        }
        .bus-card:hover {
            box-shadow: 0 5px 25px rgba(0,0,0,0.1);
            transform: translateY(-2px);
        }
        .bus-card .card-body {
            padding: 1.25rem 1.5rem;
        }
        .bus-operator {
            font-weight: 700;
            color: #1a1a2e;
        }
        .bus-number {
            font-size: 0.8rem;
            color: #6c757d;
        }
        .bus-rating {
            color: #ffc107;
            font-size: 0.85rem;
        }
        .bus-rating .rating-number {
            background: #198754;
            color: #fff;
            padding: 0.15rem 0.5rem;
            border-radius: 4px;
            font-weight: 600;
            font-size: 0.8rem;
        }
        .time-block {
            text-align: center;
        }
        .time-block .time {
            font-size: 1.25rem;
            font-weight: 700;
            color: #1a1a2e;
        }
        .time-block .city {
            font-size: 0.8rem;
            color: #6c757d;
        }
        .duration {
            text-align: center;
            position: relative;
        }
        .duration .line {
            border-top: 2px dashed #dee2e6;
            margin: 0.3rem 0;
            position: relative;
        }
        .duration .line .fa-bus {
            position: absolute;
            top: -10px;
            left: 50%;
            transform: translateX(-50%);
            background: #f8f9fa;
            padding: 0 0.5rem;
            color: #0d6efd;
            font-size: 0.8rem;
        }
        .duration .dur-text {
            font-size: 0.8rem;
            color: #6c757d;
        }
        .fare-section {
            text-align: center;
        }
        .fare-section .starting-from {
            font-size: 0.75rem;
            color: #6c757d;
        }
        .fare-section .fare {
            font-size: 1.3rem;
            font-weight: 800;
            color: #1a1a2e;
        }
        .fare-section .seats {
            font-size: 0.8rem;
            color: #198754;
            font-weight: 600;
        }
        .fare-section .seats.few {
            color: #dc3545;
        }
        .amenities-icons {
            display: flex;
            gap: 0.75rem;
            flex-wrap: wrap;
        }
        .amenities-icons .amenity {
            font-size: 0.75rem;
            color: #6c757d;
            text-align: center;
        }
        .amenities-icons .amenity i {
            font-size: 1rem;
            display: block;
            margin-bottom: 0.15rem;
        }
        .sort-bar {
            display: flex;
            align-items: center;
            gap: 0.5rem;
            margin-bottom: 1rem;
            flex-wrap: wrap;
        }
        .sort-bar .sort-label {
            font-weight: 600;
            font-size: 0.9rem;
            color: #6c757d;
        }
        .sort-bar .btn-sort {
            padding: 0.3rem 0.8rem;
            border-radius: 20px;
            font-size: 0.85rem;
            border: 1px solid #dee2e6;
            background: #fff;
            color: #495057;
            transition: all 0.2s;
        }
        .sort-bar .btn-sort:hover,
        .sort-bar .btn-sort.active {
            background: #0d6efd;
            color: #fff;
            border-color: #0d6efd;
        }
        .bus-badge {
            font-size: 0.7rem;
            padding: 0.2rem 0.5rem;
            border-radius: 4px;
            font-weight: 600;
        }
        .bus-badge.ac { background: #dbeafe; color: #1e40af; }
        .bus-badge.non-ac { background: #fef3c7; color: #92400e; }
        .bus-badge.sleeper { background: #f3e8ff; color: #6b21a8; }
        .bus-badge.seater { background: #fce7f3; color: #9d174d; }
        .no-results {
            text-align: center;
            padding: 4rem 2rem;
        }
        .no-results .icon {
            font-size: 4rem;
            color: #d1d5db;
            margin-bottom: 1rem;
        }
        .btn-view-seats {
            border-radius: 8px;
            font-weight: 600;
            padding: 0.5rem 1.25rem;
        }
        @@media (max-width: 768px) {
            .criteria-bar .route { font-size: 1rem; }
            .time-block .time { font-size: 1rem; }
            .fare-section .fare { font-size: 1.1rem; }
            .sort-bar { gap: 0.3rem; }
            .sort-bar .btn-sort { font-size: 0.75rem; padding: 0.2rem 0.6rem; }
        }
    </style>
}

<div class="search-page py-4">
    <div class="container">
        <!-- Criteria Summary Bar -->
        <div class="criteria-bar">
            <div class="row align-items-center">
                <div class="col-md-6 mb-2 mb-md-0">
                    <div class="route">
                        @Model.SourceCityName <i class="fas fa-arrow-right arrow"></i> @Model.DestinationCityName
                    </div>
                </div>
                <div class="col-md-3 mb-2 mb-md-0">
                    <span class="date-badge">
                        <i class="fas fa-calendar-alt me-2"></i>@Model.SearchCriteria.JourneyDate.ToString("dd MMM yyyy, dddd")
                    </span>
                </div>
                <div class="col-md-3 text-md-end">
                    <span class="date-badge">
                        <i class="fas fa-bus me-2"></i>@Model.Buses.Count() buses found
                    </span>
                    <a href="/Search" class="btn btn-outline-light btn-sm ms-2">
                        <i class="fas fa-edit me-1"></i>Modify
                    </a>
                </div>
            </div>
        </div>

        <div class="row">
            <!-- Filter Sidebar -->
            <div class="col-lg-3 mb-4">
                <div class="card filter-card">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <span><i class="fas fa-filter me-2"></i>Filters</span>
                        <a href="#" class="text-decoration-none small" id="clearFilters">Clear All</a>
                    </div>
                    <div class="card-body">
                        <!-- Bus Type -->
                        <div class="filter-section">
                            <div class="filter-title">Bus Type</div>
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" value="AC" id="filterAC" />
                                <label class="form-check-label" for="filterAC">AC</label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" value="Non-AC" id="filterNonAC" />
                                <label class="form-check-label" for="filterNonAC">Non-AC</label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" value="Sleeper" id="filterSleeper" />
                                <label class="form-check-label" for="filterSleeper">Sleeper</label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" value="Seater" id="filterSeater" />
                                <label class="form-check-label" for="filterSeater">Seater</label>
                            </div>
                        </div>

                        <!-- Operator -->
                        <div class="filter-section">
                            <div class="filter-title">Operator</div>
                            @if (Model.Buses != null)
                            {
                                foreach (var op in Model.Buses.Select(b => b.OperatorName).Distinct())
                                {
                                    <div class="form-check">
                                        <input class="form-check-input filter-operator" type="checkbox" value="@op" id="op_@op.Replace(" ", "")" />
                                        <label class="form-check-label" for="op_@op.Replace(" ", "")">@op</label>
                                    </div>
                                }
                            }
                        </div>

                        <!-- Departure Time -->
                        <div class="filter-section">
                            <div class="filter-title">Departure Time</div>
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" value="0-6" id="depEarly" />
                                <label class="form-check-label" for="depEarly">Early Morning (12am - 6am)</label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" value="6-12" id="depMorning" />
                                <label class="form-check-label" for="depMorning">Morning (6am - 12pm)</label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" value="12-18" id="depAfternoon" />
                                <label class="form-check-label" for="depAfternoon">Afternoon (12pm - 6pm)</label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" value="18-24" id="depEvening" />
                                <label class="form-check-label" for="depEvening">Evening (6pm - 12am)</label>
                            </div>
                        </div>

                        <!-- Arrival Time -->
                        <div class="filter-section">
                            <div class="filter-title">Arrival Time</div>
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" value="0-6" id="arrEarly" />
                                <label class="form-check-label" for="arrEarly">Early Morning (12am - 6am)</label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" value="6-12" id="arrMorning" />
                                <label class="form-check-label" for="arrMorning">Morning (6am - 12pm)</label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" value="12-18" id="arrAfternoon" />
                                <label class="form-check-label" for="arrAfternoon">Afternoon (12pm - 6pm)</label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" value="18-24" id="arrEvening" />
                                <label class="form-check-label" for="arrEvening">Evening (6pm - 12am)</label>
                            </div>
                        </div>

                        <!-- Price Range -->
                        <div class="filter-section">
                            <div class="filter-title">Price Range</div>
                            <div class="price-range">
                                <input type="number" class="form-control form-control-sm" id="minPrice" placeholder="Min" min="0" />
                                <span class="text-muted">-</span>
                                <input type="number" class="form-control form-control-sm" id="maxPrice" placeholder="Max" min="0" />
                            </div>
                        </div>

                        <button class="btn btn-primary w-100 mt-3" id="applyFilters">
                            <i class="fas fa-search me-2"></i>Apply Filters
                        </button>
                    </div>
                </div>
            </div>

            <!-- Results -->
            <div class="col-lg-9">
                <!-- Sort Bar -->
                <div class="sort-bar">
                    <span class="sort-label">Sort by:</span>
                    <button class="btn-sort active" data-sort="departure">Departure</button>
                    <button class="btn-sort" data-sort="arrival">Arrival</button>
                    <button class="btn-sort" data-sort="price">Price</button>
                    <button class="btn-sort" data-sort="duration">Duration</button>
                    <button class="btn-sort" data-sort="rating">Rating</button>
                </div>

                @if (Model.Buses != null && Model.Buses.Any())
                {
                    <div id="resultsContainer">
                        @foreach (var bus in Model.Buses)
                        {
                            <a href="@Url.Action("BusDetail", "Search", new { scheduleId = bus.ScheduleId, journeyDate = Model.SearchCriteria.JourneyDate })" class="text-decoration-none">
                                <div class="card bus-card" data-departure="@bus.DepartureTime"
                                     data-arrival="@bus.ArrivalTime"
                                     data-price="@bus.BaseFare"
                                     data-duration="@bus.DurationMinutes"
                                     data-rating="@bus.Rating">
                                    <div class="card-body">
                                        <div class="row align-items-center g-3">
                                            <!-- Operator Info -->
                                            <div class="col-lg-3 col-md-4">
                                                <div class="d-flex align-items-center mb-1">
                                                    <img src="@bus.OperatorLogo" alt="@bus.OperatorName" class="me-2"
                                                         style="width:32px;height:32px;object-fit:contain;"
                                                         onerror="this.src='data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 width=%2232%22 height=%2232%22><rect fill=%22%230d6efd%22 width=%2232%22 height=%2232%22 rx=%224%22/><text x=%224%22 y=%2220%22 font-size=%2212%22 fill=%22white%22 font-weight=%22bold%22>@bus.OperatorName.Substring(0,1)</text></svg>'" />
                                                    <div>
                                                        <div class="bus-operator">@bus.OperatorName</div>
                                                        <div class="bus-number">@bus.BusNumber</div>
                                                    </div>
                                                </div>
                                                <div class="bus-rating">
                                                    <span class="rating-number">@bus.Rating.ToString("F1")</span>
                                                    <i class="fas fa-star text-warning ms-1"></i>
                                                </div>
                                                <div class="mt-1">
                                                    @if (bus.IsAC)
                                                    {
                                                        <span class="bus-badge ac me-1">AC</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="bus-badge non-ac me-1">Non-AC</span>
                                                    }
                                                    @if (bus.IsSleeper)
                                                    {
                                                        <span class="bus-badge sleeper me-1">Sleeper</span>
                                                    }
                                                    @if (!bus.IsSleeper)
                                                    {
                                                        <span class="bus-badge seater">Seater</span>
                                                    }
                                                </div>
                                            </div>

                                            <!-- Route Timeline -->
                                            <div class="col-lg-5 col-md-4">
                                                <div class="row align-items-center">
                                                    <div class="col-4">
                                                        <div class="time-block">
                                                            <div class="time">@bus.DepartureTime</div>
                                                            <div class="city">@Model.SourceCityName</div>
                                                        </div>
                                                    </div>
                                                    <div class="col-4">
                                                        <div class="duration">
                                                            <div class="dur-text">@bus.Duration</div>
                                                            <div class="line">
                                                                <i class="fas fa-bus"></i>
                                                            </div>
                                                        </div>
                                                    </div>
                                                    <div class="col-4">
                                                        <div class="time-block">
                                                            <div class="time">@bus.ArrivalTime</div>
                                                            <div class="city">@Model.DestinationCityName</div>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>

                                            <!-- Fare & Seats -->
                                            <div class="col-lg-2 col-md-2">
                                                <div class="fare-section">
                                                    <div class="starting-from">Starting from</div>
                                                    <div class="fare">₹@bus.StartingFare.ToString("N0")</div>
                                                    <div class="seats @(bus.AvailableSeats <= 5 ? "few" : "")">
                                                        <i class="fas fa-chair me-1"></i>@bus.AvailableSeats seats
                                                    </div>
                                                </div>
                                            </div>

                                            <!-- CTA -->
                                            <div class="col-lg-2 col-md-2 text-center">
                                                <span class="btn btn-primary btn-view-seats w-100">
                                                    VIEW SEATS
                                                </span>
                                                @if (bus.Amenities != null && bus.Amenities.Any())
                                                {
                                                    <div class="amenities-icons mt-2 justify-content-center">
                                                        @foreach (var amenity in bus.Amenities.Take(4))
                                                        {
                                                            <span class="amenity" title="@amenity.Trim()">
                                                                @switch (amenity.Trim().ToLower())
                                                                {
                                                                    case "wifi":
                                                                        <i class="fas fa-wifi"></i>
                                                                        break;
                                                                    case "charging point":
                                                                        <i class="fas fa-charging-station"></i>
                                                                        break;
                                                                    case "blanket":
                                                                        <i class="fas fa-blanket"></i>
                                                                        break;
                                                                    case "water":
                                                                        <i class="fas fa-tint"></i>
                                                                        break;
                                                                    case "reading light":
                                                                        <i class="fas fa-lightbulb"></i>
                                                                        break;
                                                                    case "tracking":
                                                                        <i class="fas fa-map-marker-alt"></i>
                                                                        break;
                                                                    default:
                                                                        <i class="fas fa-check-circle"></i>
                                                                        break;
                                                                }
                                                                <span>@amenity.Trim()</span>
                                                            </span>
                                                        }
                                                    </div>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </a>
                        }
                    </div>

                    <!-- Pagination -->
                    if (Model.TotalPages > 1)
                    {
                        <nav class="mt-4">
                            <ul class="pagination justify-content-center">
                                @if (Model.CurrentPage > 1)
                                {
                                    <li class="page-item">
                                        <a class="page-link" href="?page=@(Model.CurrentPage - 1)&sourceCityId=@Model.SearchCriteria.SourceCityId&destinationCityId=@Model.SearchCriteria.DestinationCityId&journeyDate=@Model.SearchCriteria.JourneyDate.ToString("yyyy-MM-dd")">
                                            <i class="fas fa-chevron-left"></i>
                                        </a>
                                    </li>
                                }
                                @for (int i = 1; i <= Model.TotalPages; i++)
                                {
                                    <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                                        <a class="page-link" href="?page=@i&sourceCityId=@Model.SearchCriteria.SourceCityId&destinationCityId=@Model.SearchCriteria.DestinationCityId&journeyDate=@Model.SearchCriteria.JourneyDate.ToString("yyyy-MM-dd")">@i</a>
                                    </li>
                                }
                                @if (Model.CurrentPage < Model.TotalPages)
                                {
                                    <li class="page-item">
                                        <a class="page-link" href="?page=@(Model.CurrentPage + 1)&sourceCityId=@Model.SearchCriteria.SourceCityId&destinationCityId=@Model.SearchCriteria.DestinationCityId&journeyDate=@Model.SearchCriteria.JourneyDate.ToString("yyyy-MM-dd")">
                                            <i class="fas fa-chevron-right"></i>
                                        </a>
                                    </li>
                                }
                            </ul>
                        </nav>
                    }
                }
                else
                {
                    <div class="card bus-card">
                        <div class="no-results">
                            <div class="icon"><i class="fas fa-bus"></i></div>
                            <h5 class="fw-bold text-muted">No Buses Found</h5>
                            <p class="text-muted">We couldn't find any buses matching your search criteria.</p>
                            <div class="text-start d-inline-block">
                                <p class="fw-medium mb-2">Suggestions:</p>
                                <ul class="text-muted">
                                    <li>Try a different travel date</li>
                                    <li>Check for nearby cities</li>
                                    <li>Reduce your filters</li>
                                    <li>Try a different route</li>
                                </ul>
                            </div>
                            <a href="/Search" class="btn btn-primary mt-2">
                                <i class="fas fa-edit me-2"></i>Modify Search
                            </a>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            // Sort functionality
            $('.btn-sort').on('click', function () {
                $('.btn-sort').removeClass('active');
                $(this).addClass('active');
                var sortBy = $(this).data('sort');
                var cards = $('#resultsContainer').children('.bus-card').get();
                cards.sort(function (a, b) {
                    var $a = $(a), $b = $(b);
                    switch (sortBy) {
                        case 'departure':
                            return $a.data('departure').localeCompare($b.data('departure'));
                        case 'arrival':
                            return $a.data('arrival').localeCompare($b.data('arrival'));
                        case 'price':
                            return parseFloat($a.data('price')) - parseFloat($b.data('price'));
                        case 'duration':
                            return parseInt($a.data('duration')) - parseInt($b.data('duration'));
                        case 'rating':
                            return parseFloat($b.data('rating')) - parseFloat($a.data('rating'));
                        default:
                            return 0;
                    }
                });
                $.each(cards, function (idx, card) {
                    $('#resultsContainer').append(card);
                });
            });

            // Filter functionality (AJAX ready)
            $('#applyFilters').on('click', function (e) {
                e.preventDefault();
                var params = {
                    sourceCity: '@Model.SourceCityName',
                    destinationCity: '@Model.DestinationCityName',
                    travelDate: '@Model.SearchCriteria.JourneyDate.ToString("yyyy-MM-dd")',
                    busType: $('input[id^="filter"]:checked').map(function () { return $(this).val(); }).get().join(','),
                    operators: $('.filter-operator:checked').map(function () { return $(this).val(); }).get().join(','),
                    minPrice: $('#minPrice').val(),
                    maxPrice: $('#maxPrice').val()
                };
                // In a real app, this would make an AJAX call
                window.location.search = $.param(params);
            });

            $('#clearFilters').on('click', function (e) {
                e.preventDefault();
                $('.filter-card input[type="checkbox"]').prop('checked', false);
                $('#minPrice, #maxPrice').val('');
            });
        });
    </script>
}
