@using System.Linq;
@model IEnumerable<BusTravelManagement.Models.Entities.SavedPassenger>
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Saved Passengers - BusTravel Management";
}

@section Styles {
    <style>
        .section { padding: 2rem 0; background: #f8f9fa; min-height: calc(100vh - 76px - 250px); }
        .card-custom { border: none; border-radius: 12px; box-shadow: 0 2px 12px rgba(0,0,0,0.06); }
        .card-custom .card-header { background: linear-gradient(135deg, #1a1a2e, #0f3460); color: #fff; border-radius: 12px 12px 0 0 !important; padding: 1.25rem 1.5rem; }
        .card-custom .card-body { padding: 1.5rem; }
        .passenger-card { border: 1px solid #e9ecef; border-radius: 10px; padding: 1rem; transition: box-shadow 0.2s; }
        .passenger-card:hover { box-shadow: 0 2px 8px rgba(0,0,0,0.06); }
    </style>
}

<div class="section">
    <div class="container">
        <div class="card card-custom">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h5><i class="fas fa-users me-2"></i>Saved Passengers</h5>
            </div>
            <div class="card-body">
                @if (Model != null && Model.Any())
                {
                    <div class="row g-3">
                        @foreach (var passenger in Model)
                        {
                            <div class="col-md-6 col-lg-4">
                                <div class="passenger-card">
                                    <h6 class="fw-bold mb-1">@passenger.FullName</h6>
                                    <p class="text-muted small mb-1">Age: @passenger.Age | @(passenger.Gender ?? "N/A")</p>
                                    <p class="text-muted small mb-0">@passenger.PhoneNumber</p>
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="text-center text-muted py-5">
                        <i class="fas fa-user-plus fa-3x mb-3"></i>
                        <p>No saved passengers yet. You can save passenger details during booking.</p>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
