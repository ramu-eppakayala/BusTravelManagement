@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Maintenance - BusTravel Management";
}

@section Styles {
    <style>
        .error-page { min-height: calc(100vh - 76px - 250px); display: flex; align-items: center; justify-content: center; background: #f8f9fa; }
        .error-container { text-align: center; max-width: 500px; padding: 2rem; }
        .error-icon { font-size: 4rem; color: #0d6efd; margin-bottom: 1rem; }
        .error-title { font-size: 2rem; font-weight: 800; color: #1a1a2e; margin-bottom: 1rem; }
        .error-message { color: #6c757d; margin-bottom: 2rem; }
    </style>
}

<div class="error-page">
    <div class="error-container">
        <div class="error-icon"><i class="fas fa-tools"></i></div>
        <h1 class="error-title">Under Maintenance</h1>
        <p class="error-message">@(ViewBag.Message ?? "We are performing scheduled maintenance. Please check back shortly.")</p>
        <a href="/" class="btn btn-primary btn-lg"><i class="fas fa-home me-2"></i>Go to Home</a>
    </div>
</div>
