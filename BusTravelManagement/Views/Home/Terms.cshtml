@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Terms & Conditions - BusTravel Management";
}

@section Styles {
    <style>
        .terms-section { padding: 4rem 0; }
        .terms-section h2 { font-weight: 700; color: #1a1a2e; margin-bottom: 2rem; }
        .terms-section h5 { font-weight: 600; color: #1a1a2e; margin-top: 1.5rem; }
        .terms-section p, .terms-section li { color: #6c757d; line-height: 1.8; }
    </style>
}

<div class="terms-section">
    <div class="container">
        <div class="row">
            <div class="col-lg-10 mx-auto">
                <h2>Terms & Conditions</h2>
                <p>Please read these terms and conditions carefully before using our services.</p>
                <h5>1. Booking & Cancellation</h5>
                <p>All bookings are subject to availability. Cancellation charges apply as per the operator's policy. Refunds are processed within 5-7 business days.</p>
                <h5>2. User Responsibilities</h5>
                <p>Users must provide accurate information during booking. Any misuse of the platform may result in account termination.</p>
                <h5>3. Operator Responsibilities</h5>
                <p>Operators are responsible for providing accurate schedules and maintaining their buses as per regulatory standards.</p>
                <h5>4. Payment Terms</h5>
                <p>All payments are processed through secure gateways. We do not store any payment information.</p>
                <h5>5. Limitation of Liability</h5>
                <p>BusTravel Management acts as a facilitator between passengers and operators. We are not liable for any loss or damage arising from the services provided by operators.</p>
            </div>
        </div>
    </div>
</div>
