@model BusTravelManagement.Models.ViewModels.BookingDetailViewModel
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Cancel Booking - BusTravel Management";
}

@section Styles {
    <style>
        .cancel-section { padding: 2rem 0; background: #f8f9fa; min-height: calc(100vh - 76px - 250px); }
        .cancel-card { border: none; border-radius: 12px; box-shadow: 0 2px 12px rgba(0,0,0,0.06); }
        .cancel-card .card-header { background: linear-gradient(135deg, #dc3545, #b02a37); color: #fff; border-radius: 12px 12px 0 0 !important; padding: 1.25rem 1.5rem; }
        .cancel-card .card-body { padding: 2rem; }
        .cancel-card .form-label { font-weight: 600; }
        .cancel-card .form-control { padding: 0.6rem 1rem; border-radius: 8px; border: 2px solid #e9ecef; }
        .cancel-card .form-control:focus { border-color: #dc3545; box-shadow: none; }
    </style>
}

<div class="cancel-section">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-8">
                <div class="card cancel-card">
                    <div class="card-header">
                        <h5><i class="fas fa-times-circle me-2"></i>Cancel Booking</h5>
                    </div>
                    <div class="card-body">
                        <p class="mb-4">You are about to cancel booking <strong>#@Model.BookingNumber</strong> for @Model.BusNumber on @Model.JourneyDate.ToString("dd MMM yyyy").</p>

                        @using (Html.BeginForm("Cancel", "Booking", new { bookingNumber = Model.BookingNumber }, FormMethod.Post, new { role = "form" }))
                        {
                            @Html.AntiForgeryToken()

                            <div class="mb-3">
                                <label class="form-label">Reason for Cancellation</label>
                                @Html.TextArea("reason", new { @class = "form-control", rows = 3, placeholder = "Please provide a reason for cancellation (optional)" })
                            </div>

                            <div class="alert alert-warning">
                                <i class="fas fa-info-circle me-2"></i>Cancellation charges may apply as per the operator's policy. Refund will be processed within 5-7 business days.
                            </div>

                            <div class="text-end mt-4">
                                <a href="@Url.Action("Detail", new { bookingNumber = Model.BookingNumber })" class="btn btn-outline-secondary me-2"><i class="fas fa-arrow-left me-2"></i>Go Back</a>
                                <button type="submit" class="btn btn-danger"><i class="fas fa-times me-2"></i>Confirm Cancellation</button>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
