@model BusTravelManagement.Models.ViewModels.BookingDetailViewModel
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Booking Details - BusTravel Management";
}

@section Styles {
    <style>
        .detail-section { padding: 2rem 0; background: #f8f9fa; min-height: calc(100vh - 76px - 250px); }
        .detail-card { border: none; border-radius: 12px; box-shadow: 0 2px 12px rgba(0,0,0,0.06); margin-bottom: 1.5rem; }
        .detail-card .card-header { background: linear-gradient(135deg, #1a1a2e, #0f3460); color: #fff; border-radius: 12px 12px 0 0 !important; padding: 1.25rem 1.5rem; }
        .detail-card .card-body { padding: 1.5rem; }
        .label-text { color: #6c757d; font-size: 0.85rem; }
        .value-text { font-weight: 600; color: #1a1a2e; }
    </style>
}

<div class="detail-section">
    <div class="container">
        <div class="row">
            <div class="col-lg-8 mx-auto">
                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert alert-success">@TempData["SuccessMessage"]</div>
                }
                @if (TempData["ErrorMessage"] != null)
                {
                    <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
                }

                <div class="card detail-card">
                    <div class="card-header">
                        <h5><i class="fas fa-ticket-alt me-2"></i>Booking #@Model.BookingNumber</h5>
                    </div>
                    <div class="card-body">
                        <div class="row g-3">
                            <div class="col-md-6">
                                <div class="label-text">Status</div>
                                <div class="value-text">
                                    <span class="badge bg-@(Model.BookingStatus == "Confirmed" ? "success" : Model.BookingStatus == "Cancelled" ? "danger" : "warning")">@Model.BookingStatus</span>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="label-text">Booking Date</div>
                                <div class="value-text">@Model.BookedAt.ToString("dd MMM yyyy hh:mm tt")</div>
                            </div>
                            <div class="col-12"><hr /></div>
                            <div class="col-md-6">
                                <div class="label-text">Bus</div>
                                <div class="value-text">@Model.BusNumber</div>
                            </div>
                            <div class="col-md-6">
                                <div class="label-text">Operator</div>
                                <div class="value-text">@Model.OperatorName</div>
                            </div>
                            <div class="col-md-4">
                                <div class="label-text">From</div>
                                <div class="value-text">@Model.SourceCity</div>
                            </div>
                            <div class="col-md-4">
                                <div class="label-text">To</div>
                                <div class="value-text">@Model.DestinationCity</div>
                            </div>
                            <div class="col-md-4">
                                <div class="label-text">Journey Date</div>
                                <div class="value-text">@Model.JourneyDate.ToString("dd MMM yyyy")</div>
                            </div>
                            <div class="col-12"><hr /></div>
                            <div class="col-md-6">
                                <div class="label-text">Passengers</div>
                                <div class="value-text">@Model.NumberOfSeats</div>
                            </div>
                            <div class="col-md-6">
                                <div class="label-text">Total Amount</div>
                                <div class="value-text">₹@Model.NetAmount.ToString("N2")</div>
                            </div>
                            <div class="col-12">
                                <div class="label-text">Boarding Point</div>
                                <div class="value-text">@Model.BoardingPoint</div>
                            </div>
                        </div>
                        <div class="mt-4">
                            <a href="@Url.Action("ViewTicket", new { bookingNumber = Model.BookingNumber })" class="btn btn-primary"><i class="fas fa-eye me-2"></i>View Ticket</a>
                            <a href="@Url.Action("MyBookings", "Account")" class="btn btn-outline-secondary"><i class="fas fa-arrow-left me-2"></i>Back to My Bookings</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
