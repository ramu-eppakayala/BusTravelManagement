@section Scripts {
    <script>
        $(document).ready(function () {
            function setupAutocomplete(inputId, hiddenId, suggestionsId) {
                var input = $('#' + inputId);
                var hidden = $('#' + hiddenId);
                var suggestions = $('#' + suggestionsId);
                var request = null;

                input.on('input', function () {
                    var val = $(this).val();
                    // Text changed after a selection: drop the stored city id
                    if (hidden.val() && val.toLowerCase() !== $(this).data('selectedText')) {
                        hidden.val('');
                    }
                    if (val.length < 1) {
                        suggestions.removeClass('show');
                        return;
                    }
                    if (request) request.abort();
                    request = $.getJSON('/Search/SearchCities', { term: val }, function (results) {
                        if (!results || results.length === 0) {
                            suggestions.removeClass('show');
                            return;
                        }
                        suggestions.empty();
                        results.forEach(function (city) {
                            suggestions.append('<button class="dropdown-item" type="button" data-id="' + city.id + '" data-text="' + city.text + '">' + city.text + '</button>');
                        });
                        suggestions.addClass('show');
                    });
                });

                suggestions.on('click', '.dropdown-item', function () {
                    var id = $(this).data('id');
                    var text = $(this).data('text');
                    input.val(text).data('selectedText', text.toLowerCase());
                    hidden.val(id);
                    suggestions.removeClass('show');
                });

                $(document).on('click', function (e) {
                    if (!$(e.target).closest('.city-autocomplete').length) {
                        suggestions.removeClass('show');
                    }
                });
            }

            setupAutocomplete('sourceCity', 'sourceCityId', 'sourceSuggestions');
            setupAutocomplete('destinationCity', 'destinationCityId', 'destinationSuggestions');

            // Set min date to today
            var today = new Date().toISOString().split('T')[0];
            $('#journeyDate').attr('min', today);
        });
    </script>
}
