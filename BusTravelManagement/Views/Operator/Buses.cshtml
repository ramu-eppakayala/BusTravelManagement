@using System.Linq
@model IEnumerable<BusTravelManagement.Models.ViewModels.BusListViewModel>

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Manage Buses - BusTravel Management";
}

@section Styles {
    <style>
        .operator-page { background: #f8f9fa; min-height: calc(100vh - 76px - 250px); }
        .buses-card { border: none; border-radius: 12px; box-shadow: 0 2px 12px rgba(0,0,0,0.06); }
        .buses-card .card-header { background: #fff; border-bottom: 1px solid #e9ecef; padding: 1rem 1.25rem; border-radius: 12px 12px 0 0 !important; }
        .buses-card .card-body { padding: 0; }
        .buses-table { font-size: 0.9rem; margin-bottom: 0; }
        .buses-table th { background: #f8f9fa; font-weight: 600; color: #6c757d; font-size: 0.8rem; text-transform: uppercase; padding: 0.75rem 1rem; }
        .buses-table td { padding: 0.75rem 1rem; vertical-align: middle; }
        .status-badge { font-size: 0.75rem; padding: 0.25rem 0.6rem; border-radius: 20px; font-weight: 600; }
        .bus-type-badge { font-size: 0.7rem; padding: 0.2rem 0.5rem; border-radius: 4px; font-weight: 600; }
        .bus-type-badge.ac { background: #dbeafe; color: #1e40af; }
        .bus-type-badge.non-ac { background: #fef3c7; color: #92400e; }
        .bus-type-badge.sleeper { background: #f3e8ff; color: #6b21a8; }
        .bus-type-badge.seater { background: #fce7f3; color: #9d174d; }
        .action-btn { padding: 0.25rem 0.5rem; border-radius: 6px; }
        .search-bar .form-control { border-radius: 8px; border: 2px solid #e9ecef; padding: 0.5rem 0.75rem; max-width: 300px; }
        .search-bar .form-control:focus { border-color: #0d6efd; box-shadow: none; }
        .modal-content { border: none; border-radius: 16px; }
        .modal-header { border-bottom: 1px solid #e9ecef; border-radius: 16px 16px 0 0; }
        .modal-body { padding: 1.5rem; }
        .modal-footer { border-top: 1px solid #e9ecef; border-radius: 0 0 16px 16px; }
        .modal .form-control, .modal .form-select { padding: 0.6rem 1rem; border-radius: 8px; border: 2px solid #e9ecef; }
        .modal .form-control:focus, .modal .form-select:focus { border-color: #0d6efd; box-shadow: none; }
        @@media (max-width: 768px) { .buses-table { font-size: 0.8rem; } }
    </style>
}

<div class="operator-page py-4">
    <div class="container-fluid px-4">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h4 class="fw-bold mb-0"><i class="fas fa-bus me-2"></i>Manage Buses</h4>
            <button class="btn btn-primary" onclick="openAddBusModal()">
                <i class="fas fa-plus me-1"></i>Add Bus
            </button>
        </div>

        <div class="search-bar mb-3">
            <input type="text" class="form-control" id="searchBus" placeholder="Search by bus number, type..." />
        </div>

        <div class="card buses-card">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span><i class="fas fa-list me-2"></i>Buses (@Model.Count())</span>
            </div>
            <div class="table-responsive">
                <table class="table buses-table table-hover">
                    <thead>
                        <tr>
                            <th>Bus Number</th>
                            <th>Type</th>
                            <th>Total Seats</th>
                            <th>AC/Sleeper</th>
                            <th>Layout</th>
                            <th>Status</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            foreach (var bus in Model)
                            {
                                <tr>
                                    <td><strong>@bus.BusNumber</strong></td>
                                    <td>@bus.BusType</td>
                                    <td>@bus.TotalSeats</td>
                                    <td>
                                        @if (bus.IsAC)
                                        {
                                            <span class="bus-type-badge ac">AC</span>
                                        }
                                        else
                                        {
                                            <span class="bus-type-badge non-ac">Non-AC</span>
                                        }
                                        @if (bus.IsSleeper)
                                        {
                                            <span class="bus-type-badge sleeper">Sleeper</span>
                                        }
                                        @if (!bus.IsSleeper)
                                        {
                                            <span class="bus-type-badge seater">Seater</span>
                                        }
                                    </td>
                                    <td><small>@bus.SeatLayoutType</small></td>
                                    <td>
                                        @if (bus.IsActive)
                                        {
                                            <span class="status-badge bg-success bg-opacity-10 text-success">Active</span>
                                        }
                                        else
                                        {
                                            <span class="status-badge bg-danger bg-opacity-10 text-danger">Inactive</span>
                                        }
                                    </td>
                                    <td>
                                        <div class="btn-group btn-group-sm">
                                            <a href="@Url.Action("SeatLayout", "Operator", new { busId = bus.Id })" class="btn btn-outline-info action-btn" title="Seat Layout">
                                                <i class="fas fa-chair"></i>
                                            </a>
                                            <button class="btn btn-outline-primary action-btn" onclick="editBus('@bus.Id')" title="Edit">
                                                <i class="fas fa-edit"></i>
                                            </button>
                                            <button class="btn btn-outline-@(bus.IsActive ? "danger" : "success") action-btn" onclick="toggleBus('@bus.Id')" title="@(bus.IsActive ? "Deactivate" : "Activate")">
                                                <i class="fas fa-@(bus.IsActive ? "ban" : "check")"></i>
                                            </button>
                                            <button class="btn btn-outline-danger action-btn" onclick="deleteBus('@bus.Id')" title="Delete">
                                                <i class="fas fa-trash"></i>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="7" class="text-center text-muted py-4">No buses found. Add your first bus!</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Add Bus Modal -->
<div class="modal fade" id="addBusModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title fw-bold"><i class="fas fa-plus-circle me-2"></i>Add New Bus</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            @using (Html.BeginForm("AddBus", "Operator", FormMethod.Post))
            {
                @Html.AntiForgeryToken()
                <div class="modal-body">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label fw-medium">Bus Number</label>
                            <input type="text" name="BusNumber" class="form-control" placeholder="e.g., MH-01-AB-1234" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-medium">Bus Type</label>
                            <input type="text" name="BusType" class="form-control" placeholder="e.g., Volvo, Scania, etc." required />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-medium">Total Seats</label>
                            <input type="number" name="TotalSeats" class="form-control" value="40" min="1" required />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-medium">Seat Layout Type</label>
                            <select name="SeatLayoutType" class="form-select">
                                <option value="2x2">2x2</option>
                                <option value="2x1">2x1</option>
                                <option value="2x3">2x3</option>
                                <option value="1x2">1x2</option>
                                <option value="Custom">Custom</option>
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-medium">&nbsp;</label>
                            <div class="d-flex gap-3">
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" name="IsAC" value="true" id="busAC" />
                                    <label class="form-check-label" for="busAC">AC</label>
                                </div>
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" name="IsSleeper" value="true" id="busSleeper" />
                                    <label class="form-check-label" for="busSleeper">Sleeper</label>
                                </div>
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" name="IsSeater" value="true" id="busSeater" />
                                    <label class="form-check-label" for="busSeater">Seater</label>
                                </div>
                            </div>
                        </div>
                        <div class="col-12">
                            <label class="form-label fw-medium">Amenities</label>
                            <div class="row g-2">
                                <div class="col-md-3 col-6">
                                    <div class="form-check">
                                        <input class="form-check-input" type="checkbox" name="Amenities" value="WiFi" id="amenWifi" />
                                        <label class="form-check-label" for="amenWifi">WiFi</label>
                                    </div>
                                </div>
                                <div class="col-md-3 col-6">
                                    <div class="form-check">
                                        <input class="form-check-input" type="checkbox" name="Amenities" value="Charging Point" id="amenCharging" />
                                        <label class="form-check-label" for="amenCharging">Charging Point</label>
                                    </div>
                                </div>
                                <div class="col-md-3 col-6">
                                    <div class="form-check">
                                        <input class="form-check-input" type="checkbox" name="Amenities" value="Blanket" id="amenBlanket" />
                                        <label class="form-check-label" for="amenBlanket">Blanket</label>
                                    </div>
                                </div>
                                <div class="col-md-3 col-6">
                                    <div class="form-check">
                                        <input class="form-check-input" type="checkbox" name="Amenities" value="Water" id="amenWater" />
                                        <label class="form-check-label" for="amenWater">Water Bottle</label>
                                    </div>
                                </div>
                                <div class="col-md-3 col-6">
                                    <div class="form-check">
                                        <input class="form-check-input" type="checkbox" name="Amenities" value="Reading Light" id="amenLight" />
                                        <label class="form-check-label" for="amenLight">Reading Light</label>
                                    </div>
                                </div>
                                <div class="col-md-3 col-6">
                                    <div class="form-check">
                                        <input class="form-check-input" type="checkbox" name="Amenities" value="Tracking" id="amenTracking" />
                                        <label class="form-check-label" for="amenTracking">GPS Tracking</label>
                                    </div>
                                </div>
                                <div class="col-md-3 col-6">
                                    <div class="form-check">
                                        <input class="form-check-input" type="checkbox" name="Amenities" value="Toilet" id="amenToilet" />
                                        <label class="form-check-label" for="amenToilet">Toilet</label>
                                    </div>
                                </div>
                                <div class="col-md-3 col-6">
                                    <div class="form-check">
                                        <input class="form-check-input" type="checkbox" name="Amenities" value="Snacks" id="amenSnacks" />
                                        <label class="form-check-label" for="amenSnacks">Snacks</label>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-12">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" name="IsActive" value="true" checked id="newBusActive" />
                                <label class="form-check-label" for="newBusActive">Active</label>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary"><i class="fas fa-save me-1"></i>Add Bus</button>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function openAddBusModal() {
            var modal = new bootstrap.Modal(document.getElementById('addBusModal'));
            modal.show();
        }

        function toggleBus(busId) {
            if (confirm('Toggle bus status?')) {
                $.ajax({
                    url: '/Operator/ToggleBus',
                    type: 'POST',
                    data: { busId: busId },
                    success: function () { location.reload(); }
                });
            }
        }

        function editBus(busId) {
            alert('Edit bus: ' + busId);
        }

        function deleteBus(busId) {
            if (confirm('Are you sure you want to delete this bus?')) {
                $.ajax({
                    url: '/Operator/DeleteBus',
                    type: 'POST',
                    data: { busId: busId },
                    success: function () { location.reload(); }
                });
            }
        }

        $(document).ready(function () {
            $('#searchBus').on('keyup', function () {
                var val = $(this).val().toLowerCase();
                $('.buses-table tbody tr').each(function () {
                    $(this).toggle($(this).text().toLowerCase().indexOf(val) > -1);
                });
            });
        });
    </script>
}
