
@model BusTravelManagement.Models.ViewModels.BookingHistoryViewModel

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "My Bookings - BusTravel Management";
}

@section Styles {
    <style>
        .bookings-page {
            min-height: calc(100vh - 76px - 250px);
            background: #f8f9fa;
        }
        .bookings-header {
            background: linear-gradient(135deg, #1a1a2e, #0f3460);
            border-radius: 16px;
            padding: 2rem;
            color: #fff;
            margin-bottom: 2rem;
        }
        .booking-card {
            border: none;
            border-radius: 12px;
            box-shadow: 0 2px 12px rgba(0, 0, 0, 0.06);
            transition: all 0.3s;
        }
        .booking-card:hover {
            box-shadow: 0 5px 20px rgba(0, 0, 0, 0.1);
            transform: translateY(-2px);
        }
        .booking-card .card-body {
            padding: 1.25rem 1.5rem;
        }
        .booking-status {
            font-weight: 600;
            font-size: 0.8rem;
            padding: 0.3rem 0.8rem;
            border-radius: 20px;
            text-transform: uppercase;
        }
        .status-confirmed { background-color: #d1fae5; color: #065f46; }
        .status-cancelled { background-color: #fee2e2; color: #991b1b; }
        .status-completed { background-color: #dbeafe; color: #1e40af; }
        .status-pending { background-color: #fef3c7; color: #92400e; }
        .booking-route {
            font-size: 1.1rem;
            font-weight: 700;
            color: #1a1a2e;
        }
        .booking-route .arrow {
            color: #0d6efd;
            margin: 0 0.5rem;
        }
        .booking-details small {
            color: #6c757d;
        }
        .booking-details strong {
            color: #1a1a2e;
        }
        .no-bookings {
            text-align: center;
            padding: 4rem 2rem;
        }
        .no-bookings .icon {
            font-size: 4rem;
            color: #d1d5db;
            margin-bottom: 1rem;
        }
        .pagination .page-link {
            border-radius: 8px;
            margin: 0 2px;
            color: #0d6efd;
            border: 1px solid #e9ecef;
        }
        .pagination .page-item.active .page-link {
            background-color: #0d6efd;
            border-color: #0d6efd;
        }
        @@media (max-width: 768px) {
            .booking-route { font-size: 0.95rem; }
        }
    </style>
}

<div class="bookings-page py-4">
    <div class="container">
        <div class="bookings-header">
            <div class="row align-items-center">
                <div class="col">
                    <h4 class="fw-bold mb-1"><i class="fas fa-ticket-alt me-2"></i>My Bookings</h4>
                    <p class="mb-0 opacity-75">View and manage your bus booking history</p>
                </div>
                <div class="col-auto">
                    <a href="/Search" class="btn btn-light btn-sm">
                        <i class="fas fa-plus me-1"></i>Book New
                    </a>
                </div>
            </div>
        </div>

        @if (Model != null && Model.Bookings.Any())
        {
            <!-- Desktop table view -->
            <div class="d-none d-md-block">
                <div class="card booking-card">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Booking #</th>
                                    <th>Bus</th>
                                    <th>Route</th>
                                    <th>Date</th>
                                    <th>Status</th>
                                    <th>Amount</th>
                                    <th>Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.Bookings)
                                {
                                    <tr>
                                        <td>
                                            <strong>@item.BookingNumber</strong>
                                        </td>
                                        <td>
                                            <small class="text-muted d-block">@item.OperatorName</small>
                                            <span>@item.BusNumber</span>
                                        </td>
                                        <td>
                                            <span class="fw-medium">@item.SourceCity</span>
                                            <i class="fas fa-arrow-right text-primary mx-1 small"></i>
                                            <span class="fw-medium">@item.DestinationCity</span>
                                        </td>
                                        <td>
                                            <span>@item.JourneyDate.ToString("dd MMM yyyy")</span>
                                            <br />
                                            <small class="text-muted">@item.DepartureTime</small>
                                        </td>
                                        <td>
                                            <span class="booking-status status-@item.BookingStatus.ToLower()">
                                                @item.BookingStatus
                                            </span>
                                        </td>
                                        <td>
                                            <strong>₹@item.NetAmount.ToString("N2")</strong>
                                        </td>
                                        <td>
                                            @Html.ActionLink("View", "ViewTicket", "Booking", new { bookingNumber = item.BookingNumber }, new { @class = "btn btn-outline-primary btn-sm" })
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <!-- Mobile card view -->
            <div class="d-md-none">
                @foreach (var item in Model.Bookings)
                {
                    <div class="card booking-card mb-3">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <div>
                                    <strong class="text-primary">#@item.BookingNumber</strong>
                                    <small class="text-muted d-block">@item.OperatorName - @item.BusNumber</small>
                                </div>
                                <span class="booking-status status-@item.BookingStatus.ToLower()">@item.BookingStatus</span>
                            </div>
                            <div class="booking-route mb-2">
                                @item.SourceCity <i class="fas fa-arrow-right arrow"></i> @item.DestinationCity
                            </div>
                            <div class="booking-details d-flex justify-content-between">
                                <div>
                                    <small>Date</small><br />
                                    <strong>@item.JourneyDate.ToString("dd MMM yyyy")</strong>
                                </div>
                                <div>
                                    <small>Time</small><br />
                                    <strong>@item.DepartureTime</strong>
                                </div>
                                <div>
                                    <small>Amount</small><br />
                                    <strong>₹@item.NetAmount.ToString("N2")</strong>
                                </div>
                            </div>
                            <div class="mt-2">
                                @Html.ActionLink("View Details", "ViewTicket", "Booking", new { bookingNumber = item.BookingNumber }, new { @class = "btn btn-primary btn-sm w-100" })
                            </div>
                        </div>
                    </div>
                }
            </div>

            <!-- Pagination -->
            if (Model.TotalPages > 1)
            {
                <nav class="mt-4">
                    <ul class="pagination justify-content-center">
                        @if (Model.CurrentPage > 1)
                        {
                            <li class="page-item">
                                <a class="page-link" href="?page=@(Model.CurrentPage - 1)&pageSize=@ViewBag.PageSize">
                                    <i class="fas fa-chevron-left"></i>
                                </a>
                            </li>
                        }
                        @for (int i = 1; i <= Model.TotalPages; i++)
                        {
                            <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                                <a class="page-link" href="?page=@i&pageSize=@ViewBag.PageSize">@i</a>
                            </li>
                        }
                        @if (Model.CurrentPage < Model.TotalPages)
                        {
                            <li class="page-item">
                                <a class="page-link" href="?page=@(Model.CurrentPage + 1)&pageSize=@ViewBag.PageSize">
                                    <i class="fas fa-chevron-right"></i>
                                </a>
                            </li>
                        }
                    </ul>
                </nav>
            }
        }
        else
        {
            <div class="card booking-card">
                <div class="no-bookings">
                    <div class="icon"><i class="fas fa-ticket-alt"></i></div>
                    <h5 class="fw-bold text-muted">No Bookings Found</h5>
                    <p class="text-muted mb-0">You haven't made any bookings yet.</p>
                    <a href="/Search" class="btn btn-primary mt-3">
                        <i class="fas fa-search me-2"></i>Search Buses
                    </a>
                </div>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            // Any booking-specific JS here
        });
    </script>
}
