@using System.Linq
@model IEnumerable<BusTravelManagement.Models.ViewModels.UserListViewModel>

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Manage Users - BusTravel Management";
}

@section Styles {
    <style>
        .admin-page { background: #f8f9fa; min-height: calc(100vh - 76px - 250px); }
        .users-card { border: none; border-radius: 12px; box-shadow: 0 2px 12px rgba(0,0,0,0.06); }
        .users-card .card-header { background: #fff; border-bottom: 1px solid #e9ecef; padding: 1rem 1.25rem; border-radius: 12px 12px 0 0 !important; }
        .users-card .card-body { padding: 0; }
        .users-table { font-size: 0.9rem; margin-bottom: 0; }
        .users-table th { background: #f8f9fa; font-weight: 600; color: #6c757d; font-size: 0.8rem; text-transform: uppercase; padding: 0.75rem 1rem; }
        .users-table td { padding: 0.75rem 1rem; vertical-align: middle; }
        .search-bar { display: flex; gap: 0.5rem; flex-wrap: wrap; }
        .search-bar .form-control, .search-bar .form-select { border-radius: 8px; border: 2px solid #e9ecef; padding: 0.5rem 0.75rem; }
        .search-bar .form-control:focus, .search-bar .form-select:focus { border-color: #0d6efd; box-shadow: none; }
        .role-badge { display: inline-block; padding: 0.2rem 0.5rem; border-radius: 4px; font-size: 0.75rem; font-weight: 600; margin: 0.1rem; }
        .role-admin { background: #fee2e2; color: #991b1b; }
        .role-operator { background: #dbeafe; color: #1e40af; }
        .role-user { background: #dcfce7; color: #166534; }
        .role-superadmin { background: #f3e8ff; color: #6b21a8; }
        .status-badge { font-size: 0.75rem; padding: 0.25rem 0.6rem; border-radius: 20px; font-weight: 600; }
        .pagination .page-link { border-radius: 8px; margin: 0 2px; color: #0d6efd; }
        .pagination .page-item.active .page-link { background-color: #0d6efd; border-color: #0d6efd; }
        /* Modal Styles */
        .modal-content { border: none; border-radius: 16px; }
        .modal-header { border-bottom: 1px solid #e9ecef; border-radius: 16px 16px 0 0; }
        .modal-footer { border-top: 1px solid #e9ecef; border-radius: 0 0 16px 16px; }
        .modal .form-check-input:checked { background-color: #0d6efd; border-color: #0d6efd; }
        @@media (max-width: 768px) { .users-table { font-size: 0.8rem; } }
    </style>
}

<div class="admin-page py-4">
    <div class="container-fluid px-4">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h4 class="fw-bold mb-0"><i class="fas fa-users me-2"></i>Manage Users</h4>
            <span class="text-muted small">@Model.Count() total users</span>
        </div>

        <!-- Search/Filter Bar -->
        <div class="search-bar mb-3">
            <div class="input-group" style="max-width:300px;">
                <span class="input-group-text bg-white border-end-0"><i class="fas fa-search text-muted"></i></span>
                <input type="text" class="form-control border-start-0" id="searchUser" placeholder="Search by name, email, phone..." />
            </div>
            <select class="form-select" id="roleFilter" style="width:auto;">
                <option value="">All Roles</option>
                <option value="Admin">Admin</option>
                <option value="SuperAdmin">SuperAdmin</option>
                <option value="Operator">Operator</option>
                <option value="User">User</option>
            </select>
            <select class="form-select" id="statusFilter" style="width:auto;">
                <option value="">All Status</option>
                <option value="Active">Active</option>
                <option value="Inactive">Inactive</option>
            </select>
        </div>

        <div class="card users-card">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span><i class="fas fa-list me-2"></i>Users</span>
                <button class="btn btn-primary btn-sm" onclick="alert('Add user form')">
                    <i class="fas fa-plus me-1"></i>Add User
                </button>
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table users-table table-hover">
                        <thead>
                            <tr>
                                <th>Name</th>
                                <th>Email</th>
                                <th>Phone</th>
                                <th>Roles</th>
                                <th>Status</th>
                                <th>Last Login</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model != null && Model.Any())
                            {
                                foreach (var user in Model)
                                {
                                    <tr>
                                        <td>
                                            <div class="d-flex align-items-center">
                                                <div class="rounded-circle bg-light d-flex align-items-center justify-content-center me-2" style="width:36px;height:36px;">
                                                    <i class="fas fa-user text-muted"></i>
                                                </div>
                                                <div>
                                                    <strong>@user.Name</strong>
                                                </div>
                                            </div>
                                        </td>
                                        <td>@user.Email</td>
                                        <td>@user.PhoneNumber</td>
                                        <td>@user.Roles</td>
                                        <td>
                                            @if (user.IsActive)
                                            {
                                                <span class="status-badge bg-success bg-opacity-10 text-success border border-success">Active</span>
                                            }
                                            else
                                            {
                                                <span class="status-badge bg-danger bg-opacity-10 text-danger border border-danger">Inactive</span>
                                            }
                                        </td>
                                        <td>
                                            @if (user.LastLoginAt.HasValue)
                                            {
                                                <small>@user.LastLoginAt.Value.ToString("dd MMM yyyy")<br />@user.LastLoginAt.Value.ToString("hh:mm tt")</small>
                                            }
                                            else
                                            {
                                                <small class="text-muted">Never</small>
                                            }
                                        </td>
                                        <td>
                                            <div class="btn-group btn-group-sm">
                                                <button class="btn btn-outline-primary" onclick="openRoleModal('@user.Id', '@user.Name')" title="Assign Roles">
                                                    <i class="fas fa-shield-alt"></i>
                                                </button>
                                                <button class="btn btn-outline-@(user.IsActive ? "danger" : "success")" onclick="toggleUserStatus('@user.Id')" title="@(user.IsActive ? "Deactivate" : "Activate")">
                                                    <i class="fas fa-@(user.IsActive ? "ban" : "check")"></i>
                                                </button>
                                                <button class="btn btn-outline-danger" onclick="alert('Delete user?')" title="Delete">
                                                    <i class="fas fa-trash"></i>
                                                </button>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="7" class="text-center text-muted py-4">No users found</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Role Assignment Modal -->
<div class="modal fade" id="roleModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title fw-bold"><i class="fas fa-shield-alt me-2"></i>Assign Roles</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            @using (Html.BeginForm("AssignRoles", "Admin", FormMethod.Post))
            {
                @Html.AntiForgeryToken()
                <input type="hidden" name="UserId" id="modalUserId" />
                <div class="modal-body">
                    <p class="mb-3">Assign roles for: <strong id="modalUserName"></strong></p>
                    <div class="form-check mb-2">
                        <input class="form-check-input" type="checkbox" name="Roles" value="Admin" id="roleAdmin" />
                        <label class="form-check-label" for="roleAdmin">Admin</label>
                    </div>
                    <div class="form-check mb-2">
                        <input class="form-check-input" type="checkbox" name="Roles" value="SuperAdmin" id="roleSuperAdmin" />
                        <label class="form-check-label" for="roleSuperAdmin">Super Admin</label>
                    </div>
                    <div class="form-check mb-2">
                        <input class="form-check-input" type="checkbox" name="Roles" value="Operator" id="roleOperator" />
                        <label class="form-check-label" for="roleOperator">Operator</label>
                    </div>
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" name="Roles" value="User" id="roleUser" />
                        <label class="form-check-label" for="roleUser">User</label>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary"><i class="fas fa-save me-1"></i>Save Roles</button>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function openRoleModal(userId, userName) {
            $('#modalUserId').val(userId);
            $('#modalUserName').text(userName);
            var modal = new bootstrap.Modal(document.getElementById('roleModal'));
            modal.show();
        }

        function toggleUserStatus(userId) {
            if (confirm('Are you sure you want to change this user\'s status?')) {
                $.ajax({
                    url: '/Admin/ToggleUserStatus',
                    type: 'POST',
                    data: { userId: userId },
                    success: function () { location.reload(); }
                });
            }
        }

        $(document).ready(function () {
            // Search functionality
            $('#searchUser').on('keyup', function () {
                var val = $(this).val().toLowerCase();
                $('.users-table tbody tr').each(function () {
                    var text = $(this).text().toLowerCase();
                    $(this).toggle(text.indexOf(val) > -1);
                });
            });

            $('#roleFilter, #statusFilter').on('change', function () {
                // In production, this would trigger an AJAX reload
                var role = $('#roleFilter').val();
                var status = $('#statusFilter').val();
                console.log('Filter by role:', role, 'status:', status);
            });
        });
    </script>
}
