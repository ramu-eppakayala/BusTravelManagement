@using System.Linq
@model BusTravelManagement.Models.ViewModels.OperatorDashboardViewModel

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Operator Dashboard - BusTravel Management";
}

@section Styles {
    <style>
        .operator-page { background: #f8f9fa; min-height: calc(100vh - 76px - 250px); }
        .stat-card {
            border: none;
            border-radius: 12px;
            box-shadow: 0 2px 12px rgba(0,0,0,0.06);
            padding: 1.25rem;
            transition: all 0.3s;
        }
        .stat-card:hover { transform: translateY(-3px); box-shadow: 0 5px 20px rgba(0,0,0,0.1); }
        .stat-card .stat-icon { width: 48px; height: 48px; border-radius: 12px; display: flex; align-items: center; justify-content: center; font-size: 1.25rem; }
        .stat-card .stat-number { font-size: 1.75rem; font-weight: 800; color: #1a1a2e; }
        .stat-card .stat-label { color: #6c757d; font-size: 0.85rem; }
        .stat-card .stat-change { font-size: 0.8rem; font-weight: 600; }
        .stat-card .stat-change.up { color: #198754; }
        .stat-card .stat-change.down { color: #dc3545; }
        .icon-blue { background: #dbeafe; color: #1d4ed8; }
        .icon-green { background: #dcfce7; color: #16a34a; }
        .icon-orange { background: #fef3c7; color: #d97706; }
        .icon-purple { background: #f3e8ff; color: #7c3aed; }
        .icon-red { background: #fee2e2; color: #dc2626; }
        .chart-card { border: none; border-radius: 12px; box-shadow: 0 2px 12px rgba(0,0,0,0.06); }
        .chart-card .card-header { background: #fff; border-bottom: 1px solid #e9ecef; font-weight: 700; padding: 1rem 1.25rem; border-radius: 12px 12px 0 0 !important; }
        .chart-card .card-body { padding: 1.25rem; }
        .chart-placeholder { height: 250px; background: #f8f9fa; border-radius: 8px; display: flex; align-items: center; justify-content: center; color: #adb5bd; border: 1px dashed #dee2e6; }
        .chart-placeholder i { font-size: 2rem; margin-right: 0.75rem; }
        .data-table { font-size: 0.9rem; }
        .data-table th { background: #f8f9fa; font-weight: 600; color: #6c757d; font-size: 0.8rem; text-transform: uppercase; padding: 0.75rem 1rem; }
        .data-table td { padding: 0.75rem 1rem; vertical-align: middle; }
        .quick-action-btn { display: block; padding: 0.75rem 1rem; border: 1px solid #e9ecef; border-radius: 8px; margin-bottom: 0.5rem; color: #1a1a2e; text-decoration: none; transition: all 0.2s; }
        .quick-action-btn:hover { background: #f0f7ff; border-color: #0d6efd; color: #0d6efd; }
        .quick-action-btn i { width: 24px; }
        @@media (max-width: 768px) { .stat-card .stat-number { font-size: 1.4rem; } }
    </style>
}

<div class="operator-page py-4">
    <div class="container-fluid px-4">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h4 class="fw-bold mb-1"><i class="fas fa-bus me-2"></i>Operator Dashboard</h4>
                <p class="text-muted mb-0">Welcome, @User.Identity.Name! Manage your buses and schedules.</p>
            </div>
            <div>
                <span class="text-muted small"><i class="fas fa-calendar me-1"></i>@DateTime.Now.ToString("dd MMM yyyy, dddd")</span>
            </div>
        </div>

        <!-- Stats Cards -->
        <div class="row g-3 mb-4">
            <div class="col-xl-2 col-lg-4 col-md-6">
                <div class="stat-card">
                    <div class="d-flex justify-content-between align-items-start mb-2">
                        <div>
                            <div class="stat-number">@Model.TotalBuses</div>
                            <div class="stat-label">Total Buses</div>
                        </div>
                        <div class="stat-icon icon-blue"><i class="fas fa-bus"></i></div>
                    </div>
                    <div class="stat-change up"><i class="fas fa-check me-1"></i>@Model.TotalBuses total</div>
                </div>
            </div>
            <div class="col-xl-2 col-lg-4 col-md-6">
                <div class="stat-card">
                    <div class="d-flex justify-content-between align-items-start mb-2">
                        <div>
                            <div class="stat-number">@Model.ActiveSchedules</div>
                            <div class="stat-label">Active Schedules</div>
                        </div>
                        <div class="stat-icon icon-green"><i class="fas fa-calendar-check"></i></div>
                    </div>
                    <div class="stat-change up"><i class="fas fa-arrow-up me-1"></i>@Model.ActiveSchedules active</div>
                </div>
            </div>
            <div class="col-xl-2 col-lg-4 col-md-6">
                <div class="stat-card">
                    <div class="d-flex justify-content-between align-items-start mb-2">
                        <div>
                            <div class="stat-number">@Model.TodayBookings</div>
                            <div class="stat-label">Today's Bookings</div>
                        </div>
                        <div class="stat-icon icon-orange"><i class="fas fa-ticket-alt"></i></div>
                    </div>
                    <div class="stat-change up"><i class="fas fa-arrow-up me-1"></i>Today</div>
                </div>
            </div>
            <div class="col-xl-2 col-lg-4 col-md-6">
                <div class="stat-card">
                    <div class="d-flex justify-content-between align-items-start mb-2">
                        <div>
                            <div class="stat-number">₹@Model.TodayRevenue.ToString("N0")</div>
                            <div class="stat-label">Revenue Today</div>
                        </div>
                        <div class="stat-icon icon-purple"><i class="fas fa-rupee-sign"></i></div>
                    </div>
                    <div class="stat-change up"><i class="fas fa-arrow-up me-1"></i>Today</div>
                </div>
            </div>
            <div class="col-xl-2 col-lg-4 col-md-6">
                <div class="stat-card">
                    <div class="d-flex justify-content-between align-items-start mb-2">
                        <div>
                            <div class="stat-number">₹@Model.MonthlyRevenue.ToString("N0")</div>
                            <div class="stat-label">Revenue (Monthly)</div>
                        </div>
                        <div class="stat-icon icon-red"><i class="fas fa-chart-line"></i></div>
                    </div>
                    <div class="stat-change up"><i class="fas fa-arrow-up me-1"></i>This month</div>
                </div>
            </div>
            <div class="col-xl-2 col-lg-4 col-md-6">
                <div class="stat-card">
                    <div class="d-flex justify-content-between align-items-start mb-2">
                        <div>
                            <div class="stat-number">@Model.OccupancyRate%</div>
                            <div class="stat-label">Occupancy Rate</div>
                        </div>
                        <div class="stat-icon icon-blue"><i class="fas fa-chair"></i></div>
                    </div>
                    <div class="stat-change @(Model.OccupancyRate >= 70 ? "up" : "down")">
                        @(Model.OccupancyRate >= 70 ? "Good" : "Needs improvement")
                    </div>
                </div>
            </div>
        </div>

        <!-- Charts Row -->
        <div class="row g-3 mb-4">
            <div class="col-lg-6">
                <div class="chart-card">
                    <div class="card-header">
                        <i class="fas fa-chart-bar me-2 text-primary"></i>Weekly Revenue
                    </div>
                    <div class="card-body">
                        <div id="weekly-revenue-chart-root" class="chart-placeholder">
                            <i class="fas fa-chart-bar"></i>
                            <span>Weekly revenue chart (React component)</span>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-lg-6">
                <div class="chart-card">
                    <div class="card-header">
                        <i class="fas fa-chart-pie me-2 text-success"></i>Occupancy Rate
                    </div>
                    <div class="card-body">
                        <div id="occupancy-chart-root" class="chart-placeholder">
                            <i class="fas fa-chart-pie"></i>
                            <span>Occupancy chart (React component)</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Upcoming Trips & Recent Bookings -->
        <div class="row g-3">
            <div class="col-lg-7">
                <div class="chart-card">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <span><i class="fas fa-calendar-alt me-2"></i>Upcoming Trips</span>
                        @Html.ActionLink("Manage Schedules", "Schedules", "Operator", null, new { @class = "btn btn-outline-primary btn-sm" })
                    </div>
                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table class="table data-table table-hover mb-0">
                                <thead>
                                    <tr>
                                        <th>Bus</th>
                                        <th>Route</th>
                                        <th>Date</th>
                                        <th>Time</th>
                                        <th>Bookings</th>
                                        <th>Status</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (Model.UpcomingTrips != null && Model.UpcomingTrips.Any())
                                    {
                                        foreach (var trip in Model.UpcomingTrips)
                                        {
                                            <tr>
                                                <td><strong>@trip.BusNumber</strong></td>
                                                <td>@trip.Route</td>
                                                <td>@trip.JourneyDate.ToString("dd MMM")</td>
                                                <td>@trip.DepartureTime</td>
                                                <td>@trip.BookedSeats/@trip.TotalSeats</td>
                                                <td>
                                                    <span class="badge bg-info">
                                                        @trip.OccupancyPercent.ToString("0")% filled
                                                    </span>
                                                </td>
                                            </tr>
                                        }
                                    }
                                    else
                                    {
                                        <tr><td colspan="6" class="text-center text-muted py-3">No upcoming trips</td></tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-lg-5">
                <div class="chart-card">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <span><i class="fas fa-clock me-2"></i>Recent Bookings</span>
                        <a href="#" class="btn btn-outline-primary btn-sm">View All</a>
                    </div>
                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table class="table data-table table-hover mb-0">
                                <thead>
                                    <tr>
                                        <th>Booking #</th>
                                        <th>Customer</th>
                                        <th>Amount</th>
                                        <th>Status</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (Model.RecentBookings != null && Model.RecentBookings.Any())
                                    {
                                        foreach (var booking in Model.RecentBookings)
                                        {
                                            <tr>
                                                <td><small>@booking.BookingNumber</small></td>
                                                <td>@booking.CustomerName</td>
                                                <td>₹@booking.Amount.ToString("N2")</td>
                                                <td>
                                                    <span class="badge bg-@(booking.Status == "Confirmed" ? "success" : booking.Status == "Cancelled" ? "danger" : "warning")">
                                                        @booking.Status
                                                    </span>
                                                </td>
                                            </tr>
                                        }
                                    }
                                    else
                                    {
                                        <tr><td colspan="4" class="text-center text-muted py-3">No recent bookings</td></tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Quick Actions -->
        <div class="row mt-4">
            <div class="col-12">
                <div class="chart-card">
                    <div class="card-header">
                        <i class="fas fa-bolt me-2 text-warning"></i>Quick Actions
                    </div>
                    <div class="card-body">
                        <div class="row g-2">
                            <div class="col-md-3 col-6">
                                <a href="@Url.Action("Buses", "Operator")" class="quick-action-btn text-center">
                                    <i class="fas fa-bus me-2"></i>Manage Buses
                                </a>
                            </div>
                            <div class="col-md-3 col-6">
                                <a href="@Url.Action("Schedules", "Operator")" class="quick-action-btn text-center">
                                    <i class="fas fa-calendar me-2"></i>Manage Schedules
                                </a>
                            </div>
                            <div class="col-md-3 col-6">
                                <a href="#" class="quick-action-btn text-center">
                                    <i class="fas fa-chair me-2"></i>Seat Layouts
                                </a>
                            </div>
                            <div class="col-md-3 col-6">
                                <a href="#" class="quick-action-btn text-center">
                                    <i class="fas fa-file-alt me-2"></i>Reports
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            console.log('Operator dashboard ready');
            // React chart components would be initialized here
        });
    </script>
}
