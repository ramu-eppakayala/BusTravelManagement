@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Home - BusTravel Management";
}

@section Styles {
    <style>
        .hero-section {
            background: linear-gradient(135deg, #1a1a2e 0%, #16213e 50%, #0f3460 100%);
            color: #fff;
            padding: 80px 0;
            position: relative;
            overflow: hidden;
        }
        .hero-section::before {
            content: '';
            position: absolute;
            top: -50%;
            left: -50%;
            width: 200%;
            height: 200%;
            background: radial-gradient(circle, rgba(255,255,255,0.03) 0%, transparent 60%);
            animation: pulse 8s ease-in-out infinite;
        }
        @@keyframes pulse {
            0%, 100% { transform: scale(1); }
            50% { transform: scale(1.1); }
        }
        .hero-title {
            font-size: 2.8rem;
            font-weight: 800;
            line-height: 1.2;
        }
        .hero-subtitle {
            font-size: 1.15rem;
            opacity: 0.9;
        }
        .search-card {
            background: #fff;
            border-radius: 16px;
            padding: 30px;
            box-shadow: 0 20px 60px rgba(0,0,0,0.3);
            position: relative;
            z-index: 1;
        }
        .search-card .form-control,
        .search-card .form-select {
            padding: 0.7rem 1rem;
            border-radius: 10px;
            border: 2px solid #e9ecef;
            transition: border-color 0.3s;
        }
        .search-card .form-control:focus,
        .search-card .form-select:focus {
            border-color: #0d6efd;
            box-shadow: none;
        }
        .search-card .btn-search {
            padding: 0.7rem 2rem;
            border-radius: 10px;
            font-weight: 600;
        }
        .section-title {
            font-weight: 700;
            color: #1a1a2e;
            position: relative;
            margin-bottom: 2rem;
        }
        .section-title::after {
            content: '';
            display: block;
            width: 60px;
            height: 4px;
            background: #0d6efd;
            border-radius: 2px;
            margin-top: 10px;
        }
        .route-card {
            background: #fff;
            border: 1px solid #e9ecef;
            border-radius: 12px;
            padding: 1.25rem;
            transition: all 0.3s;
            cursor: pointer;
            text-decoration: none;
            color: inherit;
            display: block;
        }
        .route-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 10px 30px rgba(0,0,0,0.1);
            border-color: #0d6efd;
            color: inherit;
        }
        .route-card .route-arrow {
            color: #0d6efd;
            font-size: 1.2rem;
        }
        .route-card .route-price {
            font-weight: 700;
            color: #0d6efd;
        }
        .operator-card {
            background: #fff;
            border: 1px solid #e9ecef;
            border-radius: 12px;
            padding: 1.5rem;
            text-align: center;
            transition: all 0.3s;
        }
        .operator-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 10px 30px rgba(0,0,0,0.1);
        }
        .operator-card .operator-logo {
            width: 80px;
            height: 80px;
            object-fit: contain;
            margin-bottom: 1rem;
        }
        .operator-card .rating {
            color: #ffc107;
        }
        .step-card {
            text-align: center;
            padding: 2rem 1rem;
        }
        .step-number {
            width: 60px;
            height: 60px;
            line-height: 60px;
            border-radius: 50%;
            background: linear-gradient(135deg, #0d6efd, #0a58ca);
            color: #fff;
            font-size: 1.5rem;
            font-weight: 700;
            margin: 0 auto 1.5rem;
            box-shadow: 0 8px 20px rgba(13, 110, 253, 0.3);
        }
        .feature-card {
            padding: 2rem 1.5rem;
            border-radius: 12px;
            border: 1px solid #e9ecef;
            transition: all 0.3s;
            text-align: center;
            height: 100%;
        }
        .feature-card:hover {
            box-shadow: 0 10px 30px rgba(0,0,0,0.08);
        }
        .feature-icon {
            font-size: 2.5rem;
            color: #0d6efd;
            margin-bottom: 1rem;
        }
        .bg-soft-primary {
            background-color: #f0f7ff;
        }
        .popular-tag {
            font-size: 0.75rem;
            background: #dcfce7;
            color: #166534;
            padding: 0.2rem 0.6rem;
            border-radius: 20px;
        }
        .city-autocomplete {
            position: relative;
        }
        .city-autocomplete .dropdown-menu {
            width: 100%;
            max-height: 200px;
            overflow-y: auto;
        }
        @@media (max-width: 768px) {
            .hero-title { font-size: 1.8rem; }
            .hero-section { padding: 50px 0; }
            .search-card { padding: 20px; }
        }
    </style>
}

<div class="hero-section">
    <div class="container position-relative">
        <div class="row align-items-center">
            <div class="col-lg-6 mb-4 mb-lg-0">
                <h1 class="hero-title mb-3">Book Bus Tickets <br>with Confidence</h1>
                <p class="hero-subtitle mb-4">Travel across India with the largest network of bus operators. Best prices, guaranteed comfort, and 24/7 support.</p>
                <div class="d-flex gap-3 mb-3">
                    <span class="badge bg-light text-dark rounded-pill px-3 py-2"><i class="fas fa-shield-alt text-success me-1"></i> Safe Travel</span>
                    <span class="badge bg-light text-dark rounded-pill px-3 py-2"><i class="fas fa-tag text-primary me-1"></i> Best Prices</span>
                    <span class="badge bg-light text-dark rounded-pill px-3 py-2"><i class="fas fa-headset text-warning me-1"></i> 24/7 Support</span>
                </div>
            </div>
            <div class="col-lg-6">
                <form class="search-card" action="/Search/Search" method="POST">
                    <h4 class="fw-bold mb-3 text-dark">Find Your Bus</h4>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label text-dark fw-medium">From</label>
                            <div class="city-autocomplete">
                                <input type="hidden" name="sourceCityId" id="sourceCityId" />
                                <input type="text" name="sourceCity" id="sourceCity" class="form-control" placeholder="Enter source city" required autocomplete="off" />
                                <div class="dropdown-menu" id="sourceSuggestions"></div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label text-dark fw-medium">To</label>
                            <div class="city-autocomplete">
                                <input type="hidden" name="destinationCityId" id="destinationCityId" />
                                <input type="text" name="destinationCity" id="destinationCity" class="form-control" placeholder="Enter destination city" required autocomplete="off" />
                                <div class="dropdown-menu" id="destinationSuggestions"></div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label text-dark fw-medium">Date</label>
                            <input type="date" name="journeyDate" id="journeyDate" class="form-control" value="@DateTime.Now.ToString("yyyy-MM-dd")" required />
                        </div>
                        <div class="col-md-6 d-flex align-items-end">
                            <button type="submit" class="btn btn-primary btn-search w-100">
                                <i class="fas fa-search me-2"></i>Search Buses
                            </button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

