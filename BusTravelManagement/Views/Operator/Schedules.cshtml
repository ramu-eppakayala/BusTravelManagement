@using System.Linq
@model IEnumerable<BusTravelManagement.Models.ViewModels.ScheduleViewModel>

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Manage Schedules - BusTravel Management";
}

@section Styles {
    <style>
        .operator-page { background: #f8f9fa; min-height: calc(100vh - 76px - 250px); }
        .schedules-card { border: none; border-radius: 12px; box-shadow: 0 2px 12px rgba(0,0,0,0.06); }
        .schedules-card .card-header { background: #fff; border-bottom: 1px solid #e9ecef; padding: 1rem 1.25rem; border-radius: 12px 12px 0 0 !important; }
        .schedules-card .card-body { padding: 0; }
        .schedules-table { font-size: 0.9rem; margin-bottom: 0; }
        .schedules-table th { background: #f8f9fa; font-weight: 600; color: #6c757d; font-size: 0.8rem; text-transform: uppercase; padding: 0.75rem 1rem; }
        .schedules-table td { padding: 0.75rem 1rem; vertical-align: middle; }
        .status-badge { font-size: 0.75rem; padding: 0.25rem 0.6rem; border-radius: 20px; font-weight: 600; }
        .frequency-badge { font-size: 0.75rem; padding: 0.2rem 0.5rem; border-radius: 4px; font-weight: 600; }
        .frequency-badge.daily { background: #dbeafe; color: #1e40af; }
        .frequency-badge.weekly { background: #fef3c7; color: #92400e; }
        .frequency-badge.custom { background: #f3e8ff; color: #6b21a8; }
        .action-btn { padding: 0.25rem 0.5rem; border-radius: 6px; }
        .search-bar { display: flex; gap: 0.5rem; flex-wrap: wrap; }
        .search-bar .form-control, .search-bar .form-select { border-radius: 8px; border: 2px solid #e9ecef; padding: 0.5rem 0.75rem; }
        .search-bar .form-control:focus, .search-bar .form-select:focus { border-color: #0d6efd; box-shadow: none; }
        .modal-content { border: none; border-radius: 16px; }
        .modal-header { border-bottom: 1px solid #e9ecef; border-radius: 16px 16px 0 0; background: linear-gradient(135deg, #1a1a2e, #0f3460); color: #fff; }
        .modal-header .btn-close { filter: invert(1) brightness(200%); }
        .modal-body { padding: 1.5rem; }
        .modal-footer { border-top: 1px solid #e9ecef; border-radius: 0 0 16px 16px; }
        .modal .form-control, .modal .form-select { padding: 0.6rem 1rem; border-radius: 8px; border: 2px solid #e9ecef; }
        .modal .form-control:focus, .modal .form-select:focus { border-color: #0d6efd; box-shadow: none; }
        .route-display { font-weight: 600; color: #1a1a2e; }
        .route-display .arrow { color: #0d6efd; margin: 0 0.5rem; }
        @@media (max-width: 768px) { .schedules-table { font-size: 0.8rem; } }
    </style>
}

<div class="operator-page py-4">
    <div class="container-fluid px-4">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h4 class="fw-bold mb-0"><i class="fas fa-calendar-alt me-2"></i>Manage Schedules</h4>
            <button class="btn btn-primary" onclick="openCreateScheduleModal()">
                <i class="fas fa-plus me-1"></i>Add Schedule
            </button>
        </div>

        <div class="search-bar mb-3">
            <input type="text" class="form-control" id="searchSchedule" placeholder="Search by bus, route..." style="max-width:250px;" />
            <select class="form-select" id="statusFilter" style="width:auto;">
                <option value="">All Status</option>
                <option value="Active">Active</option>
                <option value="Inactive">Inactive</option>
            </select>
            <select class="form-select" id="busFilter" style="width:auto;">
                <option value="">All Buses</option>
                @if (ViewBag.Buses != null)
                {
                    foreach (var bus in ViewBag.Buses as SelectList)
                    {
                        <option value="@bus.Value">@bus.Text</option>
                    }
                }
            </select>
        </div>

        <div class="card schedules-card">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span><i class="fas fa-list me-2"></i>Schedules (@Model.Count())</span>
            </div>
            <div class="table-responsive">
                <table class="table schedules-table table-hover">
                    <thead>
                        <tr>
                            <th>Bus</th>
                            <th>Route</th>
                            <th>Departure</th>
                            <th>Arrival</th>
                            <th>Frequency</th>
                            <th>Fare</th>
                            <th>Status</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            foreach (var schedule in Model)
                            {
                                <tr>
                                    <td><strong>@schedule.BusNumber</strong></td>
                                    <td>
                                        <span class="route-display">
                                            @schedule.RouteName
                                        </span>
                                    </td>
                                    <td>
                                        @schedule.DepartureTime
                                        <br />
                                        <small class="text-muted">@(schedule.DurationMinutes / 60)h @(schedule.DurationMinutes % 60)m</small>
                                    </td>
                                    <td>
                                        @schedule.ArrivalTime
                                        <br />
                                        <small class="text-muted">@(schedule.DurationMinutes / 60)h @(schedule.DurationMinutes % 60)m</small>
                                    </td>
                                    <td>
                                        <span class="frequency-badge @schedule.Frequency.ToLower()">@schedule.Frequency</span>
                                    </td>
                                    <td><strong>₹@schedule.BaseFare.ToString("N2")</strong></td>
                                    <td>
                                        @if (schedule.IsActive)
                                        {
                                            <span class="status-badge bg-success bg-opacity-10 text-success">Active</span>
                                        }
                                        else
                                        {
                                            <span class="status-badge bg-danger bg-opacity-10 text-danger">Inactive</span>
                                        }
                                    </td>
                                    <td>
                                        <div class="btn-group btn-group-sm">
                                            <button class="btn btn-outline-primary action-btn" onclick="editSchedule('@schedule.Id')" title="Edit">
                                                <i class="fas fa-edit"></i>
                                            </button>
                                            <button class="btn btn-outline-@(schedule.IsActive ? "danger" : "success") action-btn" onclick="toggleSchedule('@schedule.Id')" title="@(schedule.IsActive ? "Deactivate" : "Activate")">
                                                <i class="fas fa-@(schedule.IsActive ? "ban" : "check")"></i>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="8" class="text-center text-muted py-4">No schedules found. Create your first schedule!</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Create Schedule Modal -->
<div class="modal fade" id="createScheduleModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title fw-bold"><i class="fas fa-plus-circle me-2"></i>Create Schedule</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            @using (Html.BeginForm("CreateSchedule", "Operator", FormMethod.Post))
            {
                @Html.AntiForgeryToken()
                <div class="modal-body">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label fw-medium">Bus</label>
                            <select name="BusId" class="form-select" required>
                                <option value="">-- Select Bus --</option>
                                @if (ViewBag.Buses != null)
                                {
                                    foreach (var bus in ViewBag.Buses as SelectList)
                                    {
                                        <option value="@bus.Value">@bus.Text</option>
                                    }
                                }
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-medium">Frequency</label>
                            <select name="Frequency" class="form-select" id="scheduleFrequency">
                                <option value="Daily">Daily</option>
                                <option value="Weekly">Weekly</option>
                                <option value="Custom">Custom</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-medium">Route</label>
                            <select name="RouteId" class="form-select" required>
                                <option value="">-- Select Route --</option>
                                @if (ViewBag.Routes != null)
                                {
                                    foreach (var route in ViewBag.Routes as SelectList)
                                    {
                                        <option value="@route.Value">@route.Text</option>
                                    }
                                }
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-medium">Duration (minutes)</label>
                            <input type="number" name="DurationMinutes" class="form-control" placeholder="e.g., 300" min="1" max="1440" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-medium">Departure Time</label>
                            <input type="time" name="DepartureTime" class="form-control" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-medium">Arrival Time</label>
                            <input type="time" name="ArrivalTime" class="form-control" required />
                        </div>
                        <div class="col-12" id="daysOfWeekSection" style="display:none;">
                            <label class="form-label fw-medium">Days of Week</label>
                            <input type="hidden" name="DaysOfWeek" id="scheduleDaysOfWeek" />
                            <div class="d-flex gap-3 flex-wrap">
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" name="DaySelection" value="Monday" id="dayMon" />
                                    <label class="form-check-label" for="dayMon">Mon</label>
                                </div>
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" name="DaySelection" value="Tuesday" id="dayTue" />
                                    <label class="form-check-label" for="dayTue">Tue</label>
                                </div>
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" name="DaySelection" value="Wednesday" id="dayWed" />
                                    <label class="form-check-label" for="dayWed">Wed</label>
                                </div>
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" name="DaySelection" value="Thursday" id="dayThu" />
                                    <label class="form-check-label" for="dayThu">Thu</label>
                                </div>
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" name="DaySelection" value="Friday" id="dayFri" />
                                    <label class="form-check-label" for="dayFri">Fri</label>
                                </div>
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" name="DaySelection" value="Saturday" id="daySat" />
                                    <label class="form-check-label" for="daySat">Sat</label>
                                </div>
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" name="DaySelection" value="Sunday" id="daySun" />
                                    <label class="form-check-label" for="daySun">Sun</label>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-medium">Base Fare (₹)</label>
                            <input type="number" name="BaseFare" class="form-control" placeholder="e.g., 500" step="0.01" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-medium">Per Km Rate (₹)</label>
                            <input type="number" name="PerKmRate" class="form-control" placeholder="e.g., 3.5" step="0.01" />
                        </div>
                        <div class="col-12">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" name="IsActive" value="true" checked id="newScheduleActive" />
                                <label class="form-check-label" for="newScheduleActive">Active</label>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary"><i class="fas fa-save me-1"></i>Create Schedule</button>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function openCreateScheduleModal() {
            var modal = new bootstrap.Modal(document.getElementById('createScheduleModal'));
            modal.show();
        }

        function toggleSchedule(scheduleId) {
            if (confirm('Toggle this schedule?')) {
                $.ajax({
                    url: '/Operator/ToggleSchedule',
                    type: 'POST',
                    data: { scheduleId: scheduleId },
                    success: function () { location.reload(); }
                });
            }
        }

        function editSchedule(scheduleId) {
            alert('Edit schedule: ' + scheduleId);
        }

        $(document).ready(function () {
            // Show/hide days of week based on frequency
            $('#scheduleFrequency').on('change', function () {
                if ($(this).val() === 'Custom') {
                    $('#daysOfWeekSection').slideDown();
                } else {
                    $('#daysOfWeekSection').slideUp();
                }
            });

            // Join selected days into a comma-separated string on submit
            $('#createScheduleModal form').on('submit', function () {
                var days = [];
                $('#daysOfWeekSection input[type="checkbox"]:checked').each(function () {
                    days.push($(this).val());
                });
                $('#scheduleDaysOfWeek').val(days.join(','));
            });

            // Search
            $('#searchSchedule').on('keyup', function () {
                var val = $(this).val().toLowerCase();
                $('.schedules-table tbody tr').each(function () {
                    $(this).toggle($(this).text().toLowerCase().indexOf(val) > -1);
                });
            });

            // Filters
            $('#statusFilter, #busFilter').on('change', function () {
                var status = $('#statusFilter').val().toLowerCase();
                var bus = $('#busFilter').val().toLowerCase();
                $('.schedules-table tbody tr').each(function () {
                    var show = true;
                    if (status) {
                        show = show && $(this).find('.status-badge').text().toLowerCase().indexOf(status) > -1;
                    }
                    if (bus) {
                        show = show && $(this).find('td:first').text().toLowerCase().indexOf(bus) > -1;
                    }
                    $(this).toggle(show);
                });
            });
        });
    </script>
}
